FROM openwrt/sdk:x86_64-v25.12.3

ARG PEREKOP_VERSION
ENV PEREKOP_VERSION=${PEREKOP_VERSION}
RUN ./setup.sh && \
    ./scripts/feeds update -a && \
    ./scripts/feeds install luci-base && \
    mkdir -p /builder/package/feeds/utilities /builder/package/feeds/luci

COPY ./perekop /builder/package/feeds/utilities/perekop
COPY ./luci-app-perekop /builder/package/feeds/luci/luci-app-perekop

RUN make defconfig && \
    make package/perekop/compile -j4 V=s && \
    make package/luci-app-perekop/compile -j4 V=s