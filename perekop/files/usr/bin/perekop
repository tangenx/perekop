check_dns_available() {
    local dns_type dns_server bootstrap_dns_server
    config_get dns_type "settings" "dns_type"
    config_get dns_server "settings" "dns_server"
    config_get bootstrap_dns_server "settings" "bootstrap_dns_server"

    local dns_status=0
    local dns_on_router=0
    local bootstrap_dns_status=0
    local dhcp_config_status=1
    local domain="google.com"

    # Mask NextDNS ID if present
    local display_dns_server="$dns_server"
    if echo "$dns_server" | grep -q "\.dns\.nextdns\.io$"; then
        local nextdns_id
        nextdns_id=$(echo "$dns_server" | cut -d'.' -f1)
        display_dns_server="$(echo "$nextdns_id" | sed 's/./*/g').dns.nextdns.io"
    elif echo "$dns_server" | grep -q "^dns\.nextdns\.io/"; then
        local masked_path
        masked_path=$(echo "$dns_server" | cut -d'/' -f2- | sed 's/./*/g')
        display_dns_server="dns.nextdns.io/$masked_path"
    fi

    if [ "$dns_type" = "doh" ]; then
        # Check if dns_server already contains a path
        local doh_path="/dns-query"
        if echo "$dns_server" | grep -q "/"; then
            # Path is already present, extract it
            doh_path="/$(echo "$dns_server" | cut -d'/' -f2-)"
            dns_server="$(echo "$dns_server" | cut -d'/' -f1)"
        fi

        if dig @"$dns_server" "$domain" +https="$doh_path" +timeout=2 +tries=1 > /dev/null 2>&1; then
            dns_status=1
        fi
    elif [ "$dns_type" = "udp" ]; then
        if dig @"$dns_server" "$domain" +timeout=2 +tries=1 > /dev/null 2>&1; then
            dns_status=1
        fi
    fi

    # Check if local DNS resolver is working
    if dig @127.0.0.1 "$domain" +timeout=2 +tries=1 > /dev/null 2>&1; then
        dns_on_router=1
    fi

    # Check bootstrap DNS server
    if [ -n "$bootstrap_dns_server" ]; then
        if dig @"$bootstrap_dns_server" "$domain" +timeout=2 +tries=1 > /dev/null 2>&1; then
            bootstrap_dns_status=1
        fi
    fi

    # Check if /etc/config/dhcp has server 127.0.0.42
    config_load dhcp
    config_foreach check_dhcp_has_perekop_dns dnsmasq
    config_load "$PEREKOP_CONFIG"

    echo "{\"dns_type\":\"$dns_type\",\"dns_server\":\"$display_dns_server\",\"dns_status\":$dns_status,\"dns_on_router\":$dns_on_router,\"bootstrap_dns_server\":\"$bootstrap_dns_server\",\"bootstrap_dns_status\":$bootstrap_dns_status,\"dhcp_config_status\":$dhcp_config_status}" | jq .
}

check_dhcp_has_perekop_dns() {
    local server_list cachesize noresolv server_found
    config_get server_list "$1" "server"
    config_get cachesize "$1" "cachesize"
    config_get noresolv "$1" "noresolv"

    server_found=0

    if [ -n "$server_list" ]; then
        for server in $server_list; do
            if [ "$server" = "127.0.0.42" ]; then
                server_found=1
                break
            fi
        done
    fi

    if [ "$cachesize" != "0" ] || [ "$noresolv" != "1" ] || [ "$server_found" != "1" ]; then
        dhcp_config_status=0
    fi
}

check_nft_rules() {
    local table_exist=0
    local rules_mangle_exist=0
    local rules_mangle_counters=0
    local rules_mangle_output_exist=0
    local rules_mangle_output_counters=0
    local rules_proxy_exist=0
    local rules_proxy_counters=0
    local rules_other_mark_exist=0

    # Generate traffic through PerekopTable
    curl -m 3 -s "https://$CHECK_PROXY_IP_DOMAIN/check" > /dev/null 2>&1 &
    local pid1=$!
    curl -m 3 -s "https://$FAKEIP_TEST_DOMAIN/check" > /dev/null 2>&1 &
    local pid2=$!

    wait $pid1 2> /dev/null
    wait $pid2 2> /dev/null
    sleep 1

    # Check if PerekopTable exists
    if nft list table inet "$NFT_TABLE_NAME" > /dev/null 2>&1; then
        table_exist=1

        # Check mangle chain rules
        if nft list chain inet "$NFT_TABLE_NAME" mangle > /dev/null 2>&1; then
            local mangle_output
            mangle_output=$(nft list chain inet "$NFT_TABLE_NAME" mangle)
            if echo "$mangle_output" | grep -q "counter"; then
                rules_mangle_exist=1

                if echo "$mangle_output" | grep "counter" | grep -qv "packets 0 bytes 0"; then
                    rules_mangle_counters=1
                fi
            fi
        fi

        # Check mangle_output chain rules
        if nft list chain inet "$NFT_TABLE_NAME" mangle_output > /dev/null 2>&1; then
            local mangle_output_output
            mangle_output_output=$(nft list chain inet "$NFT_TABLE_NAME" mangle_output)
            if echo "$mangle_output_output" | grep -q "counter"; then
                rules_mangle_output_exist=1

                if echo "$mangle_output_output" | grep "counter" | grep -qv "packets 0 bytes 0"; then
                    rules_mangle_output_counters=1
                fi
            fi
        fi

        # Check proxy chain rules
        if nft list chain inet "$NFT_TABLE_NAME" proxy > /dev/null 2>&1; then
            local proxy_output
            proxy_output=$(nft list chain inet "$NFT_TABLE_NAME" proxy)
            if echo "$proxy_output" | grep -q "counter"; then
                rules_proxy_exist=1

                if echo "$proxy_output" | grep "counter" | grep -qv "packets 0 bytes 0"; then
                    rules_proxy_counters=1
                fi
            fi
        fi
    fi

    # Check for other mark rules outside PerekopTable
    nft list tables 2> /dev/null | while read -r _ family table_name; do
        [ -z "$table_name" ] && continue

        [ "$table_name" = "$NFT_TABLE_NAME" ] && continue

        if nft list table "$family" "$table_name" 2> /dev/null | grep -q "meta mark set"; then
            touch /tmp/perekop_mark_check.$$
            break
        fi
    done

    if [ -f /tmp/perekop_mark_check.$$ ]; then
        rules_other_mark_exist=1
        rm -f /tmp/perekop_mark_check.$$
    fi

    echo "{\"table_exist\":$table_exist,\"rules_mangle_exist\":$rules_mangle_exist,\"rules_mangle_counters\":$rules_mangle_counters,\"rules_mangle_output_exist\":$rules_mangle_output_exist,\"rules_mangle_output_counters\":$rules_mangle_output_counters,\"rules_proxy_exist\":$rules_proxy_exist,\"rules_proxy_counters\":$rules_proxy_counters,\"rules_other_mark_exist\":$rules_other_mark_exist}" | jq .
}

check_fakeip() {
    curl -m 3 -s "https://$FAKEIP_TEST_DOMAIN/check" | jq .
}

#######################################
#######################################
# Xray gRPC API interface for the dashboard
# Arguments:
#   $1 - Action: get_traffic, get_proxies, set_group_proxy, get_runtime_info, test_group_delay
#   $2 - Group tag (selector section name) for set_group_proxy and test_group_delay
#   $3 - Target outbound tag for set_group_proxy
# Outputs:
#   JSON formatted response
# Usage:
#   xray_api get_traffic
#   xray_api get_proxies
#   xray_api set_group_proxy <group> <proxy_tag|"">
#   xray_api get_runtime_info
#   xray_api test_group_delay <group>
#######################################
XRAY_API_URL="$XRAY_API_LISTEN_ADDRESS:$XRAY_API_LISTEN_PORT"

xray_api() {
    local action="$1"
    case "$action" in
    get_traffic)
        xray api statsquery -s "$XRAY_API_URL" 2> /dev/null | jq '{
            uplink: ([.stat[]? | select(.name == "inbound>>>tproxy-in>>>traffic>>>uplink") | .value] | add // 0),
            downlink: ([.stat[]? | select(.name == "inbound>>>tproxy-in>>>traffic>>>downlink") | .value] | add // 0),
            outbound: (reduce (.stat // [])[] as $s ({};
                ($s.name | select(startswith("outbound>>>")) | split(">>>")) as $p |
                . + {($p[1]): ((.[$p[1]] // {}) + {($p[3]): ($s.value // 0)})}))
        }'
        ;;

    get_proxies)
        xray_api_get_proxies
        ;;

    set_group_proxy)
        xray_api_set_group_proxy "$2" "$3"
        ;;

    get_runtime_info)
        xray_api_get_runtime_info
        ;;

    test_group_delay)
        xray_api_test_group_delay "$2"
        ;;

    *)
        echo '{"error":"unknown action","available":["get_traffic","get_proxies","set_group_proxy","get_runtime_info","test_group_delay"]}' | jq .
        return 1
        ;;
    esac
}

xray_api_get_proxies() {
    # Groups with the current selection and their outbounds, based on UCI and
    # the live balancer state
    _xray_api_proxies_cb() {
        local section="$1"
        local connection_type proxy_config_type
        config_get connection_type "$section" "connection_type"
        config_get proxy_config_type "$section" "proxy_config_type"

        [ "$connection_type" != "proxy" ] && return 0

        local links_var links outbounds_json="[]" i=1 outbound_tag
        case "$proxy_config_type" in
        selector)
            links_var="selector_proxy_links"
            ;;
        urltest)
            links_var="urltest_proxy_links"
            ;;
        url | outbound)
            # A single outbound is listed as its own one-entry group, so the
            # dashboard shows it together with its latency test
            outbound_tag="$(get_outbound_tag_by_section "$section")"
            XRAY_API_PROXIES_RESULT=$(jq -n --argjson cur "$XRAY_API_PROXIES_RESULT" --arg section "$section" \
                --arg tag "$outbound_tag" \
                '$cur + {($section): {"outbounds": [$tag], "selected": $tag}}')
            return 0
            ;;
        *)
            return 0
            ;;
        esac

        config_get links "$section" "$links_var"

        for link in $links; do
            outbound_tag="$(get_outbound_tag_by_section "$section-$i")"
            outbounds_json=$(jq -n --argjson cur "$outbounds_json" --arg tag "$outbound_tag" '$cur + [$tag]')
            i=$((i + 1))
        done

        # The override target from the live balancer, "" when automatic
        local override selected
        override=$(xray api bi -json -s "$XRAY_API_URL" "$(get_outbound_tag_by_section "$section")" 2> /dev/null |
            jq -r '.balancer.override.target // ""')
        selected="$(uci -q get "perekop.$section.selector_selected")"
        [ -z "$selected" ] && selected="$override"

        XRAY_API_PROXIES_RESULT=$(jq -n --argjson cur "$XRAY_API_PROXIES_RESULT" --arg section "$section" \
            --argjson outbounds "$outbounds_json" --arg selected "$selected" \
            '$cur + {($section): {"outbounds": $outbounds, "selected": $selected}}')
    }

    XRAY_API_PROXIES_RESULT="{}"
    config_foreach _xray_api_proxies_cb "section"

    echo "$XRAY_API_PROXIES_RESULT" | jq .
}

xray_api_set_group_proxy() {
    local group="$1"
    local proxy_tag="$2"

    if [ -z "$group" ]; then
        echo '{"error":"group required"}' | jq .
        return 1
    fi

    local balancer_tag
    balancer_tag="$(get_outbound_tag_by_section "$group")"

    if [ -z "$proxy_tag" ] || [ "$proxy_tag" = "auto" ]; then
        # Remove the override, the balancer strategy takes over again
        if xray api bo -s "$XRAY_API_URL" -b "$balancer_tag" -r > /dev/null 2>&1; then
            uci -q delete "perekop.$group.selector_selected"
            uci -q commit perekop
            echo "{\"success\":true,\"group\":\"$group\",\"proxy\":\"auto\"}" | jq .
            return 0
        fi
        echo "{\"success\":false,\"error\":\"balancer_override_failed\"}" | jq .
        return 1
    fi

    if ! xray api bo -s "$XRAY_API_URL" -b "$balancer_tag" "$proxy_tag" > /dev/null 2>&1; then
        echo "{\"success\":false,\"error\":\"balancer_override_failed\"}" | jq .
        return 1
    fi

    uci set "perekop.$group.selector_selected=$proxy_tag"
    uci commit perekop

    echo "{\"success\":true,\"group\":\"$group\",\"proxy\":\"$proxy_tag\"}" | jq .
}

# Runtime state of the core for the dashboard system info widget
xray_api_get_runtime_info() {
    local pid memory=0 uptime=0 connections=0

    pid="$(pgrep -f "^/usr/bin/xray" | head -n 1)"
    if [ -n "$pid" ]; then
        memory=$(awk '/^VmRSS/ {print $2}' /proc/"$pid"/status 2>/dev/null)
        memory=$((memory * 1024))
        local uptime_now jiffies clk
        uptime_now=$(cut -d. -f1 /proc/uptime)
        jiffies=$(awk '{print $22}' /proc/"$pid"/stat 2> /dev/null)
        # OpenWrt ships no getconf; all its kernels use CLK_TCK=100
        clk=100
        uptime=$((uptime_now - jiffies / clk))
        connections=$(netstat -tn 2> /dev/null | awk '$6 == "ESTABLISHED"' | grep -c ":1602 ")
    fi

    echo "{\"memory\":$memory,\"uptime\":$uptime,\"connections\":$connections}" | jq .
}

# Measure the delay of every outbound of a proxy section: the section
# balancer is overridden to each outbound in turn and a probe request is
# sent through the dedicated loopback SOCKS inbound of the section
xray_api_test_group_delay() {
    local group="$1"
    if [ -z "$group" ]; then
        echo '{"error":"group required"}' | jq .
        return 1
    fi

    local connection_type proxy_config_type
    config_get connection_type "$group" "connection_type"
    config_get proxy_config_type "$group" "proxy_config_type"
    if [ "$connection_type" != "proxy" ]; then
        echo "{\"error\":\"$group is not a proxy section\"}" | jq .
        return 1
    fi

    local balancer_tag port links_var links tags="" outbound_tag
    case "$proxy_config_type" in
    selector)
        links_var="selector_proxy_links"
        balancer_tag="$(get_outbound_tag_by_section "$group")"
        ;;
    urltest)
        links_var="urltest_proxy_links"
        balancer_tag="$(get_outbound_tag_by_section "$group")"
        ;;
    url | outbound)
        links_var=""
        tags="$(get_outbound_tag_by_section "$group")"
        balancer_tag="$group-latency"
        ;;
    *)
        echo "{\"error\":\"$group has no testable outbounds\"}" | jq .
        return 1
        ;;
    esac

    local i=1
    if [ -n "$links_var" ]; then
        config_get links "$group" "$links_var"
        for link in $links; do
            tags="$tags $(get_outbound_tag_by_section "$group-$i")"
            i=$((i + 1))
        done
    fi

    port="$(get_latency_socks_port "$group")"
    if [ -z "$port" ]; then
        echo '{"error":"latency inbound not configured, restart perekop"}' | jq .
        return 1
    fi

    # The previously selected override is restored after the measurement
    local restore_tag result="{}" delay_ms
    restore_tag="$(uci -q get "perekop.$group.selector_selected")"

    for outbound_tag in $tags; do
        delay_ms=0
        if xray api bo -s "$XRAY_API_URL" -b "$balancer_tag" "$outbound_tag" > /dev/null 2>&1; then
            delay_ms=$(curl -s -o /dev/null -m 5 \
                -w "%{time_total}" --socks5-hostname "$XRAY_LATENCY_SOCKS_INBOUND_ADDRESS:$port" \
                "$XRAY_LATENCY_TEST_URL" 2> /dev/null | awk '{ printf "%d", $1 * 1000 }')
            [ -z "$delay_ms" ] && delay_ms=0
        fi

        result=$(jq -n --argjson cur "$result" --arg tag "$outbound_tag" --argjson ms "$delay_ms" \
            '$cur + {($tag): $ms}')
    done

    if [ -n "$restore_tag" ]; then
        xray api bo -s "$XRAY_API_URL" -b "$balancer_tag" "$restore_tag" > /dev/null 2>&1
    else
        xray api bo -s "$XRAY_API_URL" -b "$balancer_tag" -r > /dev/null 2>&1
    fi

    echo "$result" | jq .
}


check_xray() {
    local xray_installed=0
    local xray_version_ok=0
    local xray_service_exist=0
    local xray_autostart_disabled=0
    local xray_process_running=0
    local xray_ports_listening=0

    # Check if xray is installed
    if command -v xray > /dev/null 2>&1; then
        xray_installed=1

        # Check version (must be >= XRAY_REQUIRED_VERSION)
        local version
        version=$(xray_get_version)
        if [ -n "$version" ] && is_min_package_version "$version" "$XRAY_REQUIRED_VERSION"; then
            xray_version_ok=1
        fi
    fi

    # Check if service exists
    if [ -f /etc/init.d/xray ]; then
        xray_service_exist=1

        if ! /etc/init.d/xray enabled 2> /dev/null; then
            xray_autostart_disabled=1
        fi
    fi

    # Check if process is running
    if pgrep -f "xray run" > /dev/null 2>&1; then
        xray_process_running=1
    fi

    # Check if xray is listening on required ports
    local port_53_ok=0
    local port_1602_ok=0

    if netstat -ln 2> /dev/null | grep -q "127.0.0.42:53"; then
        port_53_ok=1
    fi

    if netstat -ln 2> /dev/null | grep -q "127.0.0.1:1602"; then
        port_1602_ok=1
    fi

    # Both ports must be listening
    if [ "$port_53_ok" = "1" ] && [ "$port_1602_ok" = "1" ]; then
        xray_ports_listening=1
    fi

    echo "{\"xray_installed\":$xray_installed,\"xray_version_ok\":$xray_version_ok,\"xray_service_exist\":$xray_service_exist,\"xray_autostart_disabled\":$xray_autostart_disabled,\"xray_process_running\":$xray_process_running,\"xray_ports_listening\":$xray_ports_listening}" | jq .
}


print_global() {
    local message="$1"
    echo "$message"
}

global_check() {
    local PEREKOP_LUCI_VERSION="Unknown"
    [ -n "$1" ] && PEREKOP_LUCI_VERSION="$1"

    print_global "📡 Global check run!"
    print_global "━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    print_global "🛠️ System info"

    local system_info_json
    system_info_json=$(get_system_info)

    if [ -n "$system_info_json" ]; then
        local perekop_version perekop_latest_version luci_app_version xray_version openwrt_version device_model

        perekop_version=$(echo "$system_info_json" | jq -r '.perekop_version // "unknown"')
        perekop_latest_version=$(echo "$system_info_json" | jq -r '.perekop_latest_version // "unknown"')
        luci_app_version=$(echo "$system_info_json" | jq -r '.luci_app_version // "unknown"')
        xray_version=$(echo "$system_info_json" | jq -r '.xray_version // "unknown"')
        openwrt_version=$(echo "$system_info_json" | jq -r '.openwrt_version // "unknown"')
        device_model=$(echo "$system_info_json" | jq -r '.device_model // "unknown"')

        print_global "🕳️ Perekop:        $perekop_version (latest: $perekop_latest_version)"
        print_global "🕳️ LuCI App:      $luci_app_version"
        print_global "📦 Xray:          $xray_version"
        print_global "🛜 OpenWrt:       $openwrt_version"
        print_global "🛜 Device:        $device_model"
    else
        print_global "❌ Failed to get system info"
    fi

    print_global "━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    print_global "➡️ DNS status"

    local dns_check_json
    dns_check_json=$(check_dns_available)

    if [ -n "$dns_check_json" ]; then
        local dns_type dns_server dns_status dns_on_router bootstrap_dns_server bootstrap_dns_status dhcp_config_status

        dns_type=$(echo "$dns_check_json" | jq -r '.dns_type // "unknown"')
        dns_server=$(echo "$dns_check_json" | jq -r '.dns_server // "unknown"')
        dns_status=$(echo "$dns_check_json" | jq -r '.dns_status // 0')
        dns_on_router=$(echo "$dns_check_json" | jq -r '.dns_on_router // 0')
        bootstrap_dns_server=$(echo "$dns_check_json" | jq -r '.bootstrap_dns_server // ""')
        bootstrap_dns_status=$(echo "$dns_check_json" | jq -r '.bootstrap_dns_status // 0')
        dhcp_config_status=$(echo "$dns_check_json" | jq -r '.dhcp_config_status // 0')

        # Bootstrap DNS
        if [ -n "$bootstrap_dns_server" ]; then
            if [ "$bootstrap_dns_status" -eq 1 ]; then
                print_global "✅ Bootstrap DNS: $bootstrap_dns_server"
            else
                print_global "❌ Bootstrap DNS: $bootstrap_dns_server"
            fi
        fi

        # DNS server status
        if [ "$dns_status" -eq 1 ]; then
            print_global "✅ Main DNS: $dns_server [$dns_type]"
        else
            print_global "❌ Main DNS: $dns_server [$dns_type]"
        fi

        # DNS on router
        if [ "$dns_on_router" -eq 1 ]; then
            print_global "✅ DNS on router"
        else
            print_global "❌ DNS on router"
        fi

        # DHCP configuration check
        local dont_touch_dhcp
        config_get dont_touch_dhcp "settings" "dont_touch_dhcp"

        if [ "$dont_touch_dhcp" = "1" ]; then
            print_global "⚠️ dont_touch_dhcp is enabled. 📄 DHCP config:"
            awk '/^config /{p=($2=="dnsmasq")} p' /etc/config/dhcp
        elif [ "$dhcp_config_status" -eq 0 ]; then
            print_global "❌ DHCP configuration differs from template. 📄 DHCP config:"
            awk '/^config /{p=($2=="dnsmasq")} p' /etc/config/dhcp
        else
            print_global "✅ /etc/config/dhcp"
        fi
    else
        print_global "❌ Failed to get DNS info"
    fi

    print_global "━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    print_global "📦 Xray status"

    local xray_check_json
    xray_check_json=$(check_xray)

    if [ -n "$xray_check_json" ]; then
        local xray_installed xray_version_ok xray_service_exist xray_autostart_disabled xray_process_running xray_ports_listening

        xray_installed=$(echo "$xray_check_json" | jq -r '.xray_installed // 0')
        xray_version_ok=$(echo "$xray_check_json" | jq -r '.xray_version_ok // 0')
        xray_service_exist=$(echo "$xray_check_json" | jq -r '.xray_service_exist // 0')
        xray_autostart_disabled=$(echo "$xray_check_json" | jq -r '.xray_autostart_disabled // 0')
        xray_process_running=$(echo "$xray_check_json" | jq -r '.xray_process_running // 0')
        xray_ports_listening=$(echo "$xray_check_json" | jq -r '.xray_ports_listening // 0')

        if [ "$xray_installed" -eq 1 ]; then
            print_global "✅ Xray installed"
        else
            print_global "❌ Xray installed"
        fi

        if [ "$xray_version_ok" -eq 1 ]; then
            print_global "✅ Xray version is compatible (newer than $XRAY_REQUIRED_VERSION)"
        else
            print_global "❌ Xray version is not compatible (older than $XRAY_REQUIRED_VERSION)"
        fi

        if [ "$xray_service_exist" -eq 1 ]; then
            print_global "✅ Xray service exist"
        else
            print_global "❌ Xray service exist"
        fi

        if [ "$xray_autostart_disabled" -eq 1 ]; then
            print_global "✅ Xray autostart disabled"
        else
            print_global "❌ Xray autostart disabled"
        fi

        if [ "$xray_process_running" -eq 1 ]; then
            print_global "✅ Xray process running"
        else
            print_global "❌ Xray process running"
        fi

        if [ "$xray_ports_listening" -eq 1 ]; then
            print_global "✅ Xray listening ports"
        else
            print_global "❌ Xray listening ports"
        fi
    else
        print_global "❌ Failed to get xray info"
    fi

    print_global "━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    print_global "🧱 NFT rules status"

    local nft_check_json
    nft_check_json=$(check_nft_rules)

    if [ -n "$nft_check_json" ]; then
        local table_exist rules_mangle_exist rules_mangle_counters rules_mangle_output_exist rules_mangle_output_counters rules_proxy_exist rules_proxy_counters rules_other_mark_exist

        table_exist=$(echo "$nft_check_json" | jq -r '.table_exist // 0')
        rules_mangle_exist=$(echo "$nft_check_json" | jq -r '.rules_mangle_exist // 0')
        rules_mangle_counters=$(echo "$nft_check_json" | jq -r '.rules_mangle_counters // 0')
        rules_mangle_output_exist=$(echo "$nft_check_json" | jq -r '.rules_mangle_output_exist // 0')
        rules_mangle_output_counters=$(echo "$nft_check_json" | jq -r '.rules_mangle_output_counters // 0')
        rules_proxy_exist=$(echo "$nft_check_json" | jq -r '.rules_proxy_exist // 0')
        rules_proxy_counters=$(echo "$nft_check_json" | jq -r '.rules_proxy_counters // 0')
        rules_other_mark_exist=$(echo "$nft_check_json" | jq -r '.rules_other_mark_exist // 0')

        if [ "$table_exist" -eq 1 ]; then
            print_global "✅ Table exist"
        else
            print_global "❌ Table exist"
        fi

        if [ "$rules_mangle_exist" -eq 1 ]; then
            print_global "✅ Rules mangle exist"
        else
            print_global "❌ Rules mangle exist"
        fi

        if [ "$rules_mangle_counters" -eq 1 ]; then
            print_global "✅ Rules mangle counters"
        else
            print_global "⚠️  Rules mangle counters"
        fi

        if [ "$rules_mangle_output_exist" -eq 1 ]; then
            print_global "✅ Rules mangle output exist"
        else
            print_global "❌ Rules mangle output exist"
        fi

        if [ "$rules_mangle_output_counters" -eq 1 ]; then
            print_global "✅ Rules mangle output counters"
        else
            print_global "⚠️  Rules mangle output counters"
        fi

        if [ "$rules_proxy_exist" -eq 1 ]; then
            print_global "✅ Rules proxy exist"
        else
            print_global "❌ Rules proxy exist"
        fi

        if [ "$rules_proxy_counters" -eq 1 ]; then
            print_global "✅ Rules proxy counters"
        else
            print_global "⚠️  Rules proxy counters"
        fi

        if [ "$rules_other_mark_exist" -eq 1 ]; then
            print_global "⚠️  Additional marking rules found:"
            nft list ruleset | awk '/table inet '"$NFT_TABLE_NAME"'/{flag=1; next} /^table/{flag=0} !flag' | grep -E "mark set|meta mark"
        else
            print_global "✅ Additional marking rules found"
        fi
    else
        print_global "❌ Failed to get NFT rules info"
    fi

    print_global "━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    print_global "📄 Perekop config"
    show_config

    # print_global "━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    # print_global "🔧 System check"

    # if grep -E "^nameserver\s+([0-9]{1,3}\.){3}[0-9]{1,3}" "$RESOLV_CONF" | grep -vqE "127\.0\.0\.1|0\.0\.0\.0"; then
    #     print_global "❌ /etc/resolv.conf contains external nameserver:"
    #     cat /etc/resolv.conf
    #     echo ""
    # else
    #     print_global "✅ /etc/resolv.conf"
    # fi

    # print_global "━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    # print_global "🧱 NFT table"
    # check_nft

    print_global "━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    print_global "📄 WAN config"
    if uci show network.wan > /dev/null 2>&1; then
        awk '
            /^config / {
                p = ($2 == "interface" && $3 == "'\''wan'\''")
                proto = ""
            }
            p {
                if ($1 == "option" && $2 == "proto") {
                    proto = $3
                    print
                } else if (proto == "'\''static'\''" && $1 == "option" && ($2 == "ipaddr" || $2 == "netmask" || $2 == "gateway")) {
                    print "        option", $2, "'\''******'\''"
                } else if (proto == "'\''pppoe'\''" && $1 == "option" && ($2 == "username" || $2 == "password")) {
                    print "        option", $2, "'\''******'\''"
                } else {
                    print
                }
            }
        ' /etc/config/network
    else
        print_global "❌ WAN configuration not found"
    fi

    if uci show network | grep -q endpoint_host; then
        uci show network | grep endpoint_host | cut -d'=' -f2 | tr -d "'\" " | while read -r host; do
            if [ "$host" = "engage.cloudflareclient.com" ]; then
                print_global "⚠️ WARP detected: $host"
                continue
            fi

            ip_prefix=$(echo "$host" | cut -d'.' -f1,2)
            if echo "$CLOUDFLARE_OCTETS" | grep -wq "$ip_prefix"; then
                print_global "━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                print_global "⚠️ WARP detected: $host"
            fi
        done
    fi

    if uci show network | grep -q route_allowed_ips; then
        uci show network | grep "wireguard_.*\.route_allowed_ips='1'" | cut -d'.' -f1-2 | while read -r peer_section; do
            local allowed_ips
            allowed_ips=$(uci get "${peer_section}.allowed_ips" 2> /dev/null)

            if [ "$allowed_ips" = "0.0.0.0/0" ]; then
                print_global "━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                print_global "⚠️ WG Route allowed IP enabled with 0.0.0.0/0"
            fi
        done
    fi

    if [ -f "/etc/init.d/zapret" ]; then
        print_global "━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        print_global "⚠️ Zapret detected"
    fi
    if service_exists "podkop"; then
        print_global "━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        print_global "⚠️ Podkop detected: remove it (opkg remove podkop luci-app-podkop)"
    fi

    print_global "━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    print_global "🥸 FakeIP status"

    local fakeip_check_json
    fakeip_check_json=$(check_fakeip)

    if [ -n "$fakeip_check_json" ]; then
        local fakeip_status

        fakeip_status=$(echo "$fakeip_check_json" | jq -r '.fakeip // false')

        if [ "$fakeip_status" = "true" ]; then
            print_global "✅ Router DNS is routed through xray"
        else
            print_global "⚠️ Router DNS is NOT routed through xray"
        fi
    else
        print_global "❌ Failed to get FakeIP info"
    fi

    local fakeip_address
    fakeip_address=$(dig +short @127.0.0.42 $FAKEIP_TEST_DOMAIN)

    if echo "$fakeip_address" | grep -q "^198\.18\."; then
        print_global "✅ Xray works with FakeIP: $fakeip_address"
    else
        print_global "❌ Xray does NOT work with FakeIP: $fakeip_address"
    fi
}

show_help() {
    cat << EOF
Usage: $0 COMMAND

Available commands:
    start                   Start perekop service
    stop                    Stop perekop service
    reload                  Reload perekop configuration
    restart                 Restart perekop service
    list_update             Update domain lists
    check_proxy             Check proxy connectivity
    check_nft               Check NFT rules
    check_nft_rules         Check NFT rules status
    check_xray              Check Xray installation and status
    check_logs              Show perekop logs from system journal
    check_fakeip            Test FakeIP on router
    xray_api                Xray API interface (get_traffic, get_proxies, set_group_proxy)
    show_config             Display current perekop configuration
    show_version            Show perekop version
    show_xray_config        Show Xray configuration
    show_xray_version       Show Xray version
    show_system_info        Show system information
    get_status              Get perekop service status
    get_xray_status         Get Xray service status
    get_system_info         Get system information in JSON format
    get_xray_features       Get the features of the installed Xray in JSON format
    check_dns_available     Check DNS server availability
    global_check            Run global system check
EOF
}

case "$1" in
start)
    start
    ;;
stop)
    stop
    ;;
reload)
    reload
    ;;
restart)
    restart
    ;;
list_update)
    list_update
    ;;
check_proxy)
    check_proxy
    ;;
check_nft)
    check_nft
    ;;
check_nft_rules)
    check_nft_rules
    ;;
check_xray)
    check_xray
    ;;
check_logs)
    check_logs
    ;;
check_fakeip)
    check_fakeip
    ;;
xray_api)
    xray_api "$2" "$3" "$4"
    ;;
show_config)
    show_config
    ;;
show_version)
    show_version
    ;;
show_xray_config)
    show_xray_config
    ;;
show_xray_version)
    show_xray_version
    ;;
show_system_info)
    show_system_info
    ;;
get_status)
    get_status
    ;;
get_xray_status)
    get_xray_status
    ;;
get_system_info)
    get_system_info
    ;;
get_xray_features)
    get_xray_features
    ;;
check_dns_available)
    check_dns_available
    ;;
global_check)
    global_check "${2:-}"
    ;;
*)
    show_help
    exit 1
    ;;
esac
