#!/bin/ash

check_required_file() {
    local file="$1"

    if [ ! -r "$file" ]; then
        echo "Error: required file '$file' is missing or not readable" >&2
        exit 1
    fi
}

PEREKOP_LIB="/usr/lib/perekop"
check_required_file /lib/functions.sh
check_required_file /lib/config/uci.sh
check_required_file /lib/functions/network.sh
check_required_file "$PEREKOP_LIB/constants.sh"
check_required_file "$PEREKOP_LIB/nft.sh"
check_required_file "$PEREKOP_LIB/helpers.sh"
check_required_file "$PEREKOP_LIB/xray_config_manager.sh"
check_required_file "$PEREKOP_LIB/xray_config_facade.sh"
check_required_file "$PEREKOP_LIB/logging.sh"
check_required_file "$PEREKOP_LIB/rulesets.sh"
. /lib/functions.sh
. /lib/config/uci.sh
. /lib/functions/network.sh
. "$PEREKOP_LIB/constants.sh"
. "$PEREKOP_LIB/nft.sh"
. "$PEREKOP_LIB/helpers.sh"
. "$PEREKOP_LIB/xray_config_manager.sh"
. "$PEREKOP_LIB/xray_config_facade.sh"
. "$PEREKOP_LIB/logging.sh"
. "$PEREKOP_LIB/rulesets.sh"

config_load "$PEREKOP_CONFIG"

check_requirements() {
    log "Check Requirements"

    local xray_version jq_version coreutils_base64_version
    xray_version="$(xray_get_version)"
    jq_version="$(jq --version | awk -F- '{print $2}')"
    coreutils_base64_version="$(base64 --version | head -n1 | awk '{print $4}')"

    if [ -z "$xray_version" ]; then
        log "Package 'xray-core' is not installed. Aborted." "error"
        exit 1
    else
        if ! is_min_package_version "$xray_version" "$XRAY_REQUIRED_VERSION"; then
            log "Package 'xray-core' version ($xray_version) is lower than the required minimum ($XRAY_REQUIRED_VERSION). Update xray-core: opkg update && opkg upgrade xray-core. Aborted." "error"
            exit 1
        fi

        if ! service_exists "xray"; then
            log "Service 'xray' is missing. Please install the official package to ensure the service is available. Aborted." "error"
            exit 1
        fi
    fi

    if [ -z "$jq_version" ]; then
        log "Package 'jq' is not installed. Aborted." "error"
        exit 1
    elif ! is_min_package_version "$jq_version" "$JQ_REQUIRED_VERSION"; then
        log "Package 'jq' version ($jq_version) is lower than the required minimum ($JQ_REQUIRED_VERSION). Aborted." "error"
        exit 1
    fi

    if [ -z "$coreutils_base64_version" ]; then
        log "Package 'coreutils-base64' is not installed. Aborted." "error"
        exit 1
    elif ! is_min_package_version "$coreutils_base64_version" "$COREUTILS_BASE64_REQUIRED_VERSION"; then
        log "Package 'coreutils-base64' version ($coreutils_base64_version) is lower than the required minimum ($COREUTILS_BASE64_REQUIRED_VERSION). This may cause issues when decoding base64 streams with missing padding, as automatic padding support is not available in older versions." "warn"
    fi

    if service_exists "podkop"; then
        log "Podkop is installed. Perekop is a Podkop fork, they cannot run on the same router. Remove it: opkg remove podkop luci-app-podkop. Aborted." "error"
        exit 1
    fi

    if grep -qE 'doh_backup_noresolv|doh_backup_server|doh_server' /etc/config/dhcp; then
        log "Detected https-dns-proxy in DHCP config. Edit /etc/config/dhcp" "error"
    fi

    if has_outbound_section; then
        log "Outbound section found" "debug"
    else
        log "Outbound section not found. Please check your configuration file (missing proxy_string, selector_proxy_links, urltest_proxy_links, outbound_json, or interface). Aborted." "error"
        exit 1
    fi
}

_check_outbound_section() {
    local section="$1"
    local proxy_string interface outbound_json urltest_proxy_links

    config_get proxy_string "$section" "proxy_string"
    config_get selector_proxy_links "$section" "selector_proxy_links"
    config_get urltest_proxy_links "$section" "urltest_proxy_links"
    config_get outbound_json "$section" "outbound_json"
    config_get interface "$section" "interface"

    if [ -n "$proxy_string" ] || [ -n "$selector_proxy_links" ] || [ -n "$urltest_proxy_links" ] ||
        [ -n "$outbound_json" ] || [ -n "$interface" ]; then
        section_exists=0
    fi
}

has_outbound_section() {
    local section_exists=1

    config_foreach _check_outbound_section "section"

    return $section_exists
}

start_main() {
    log "Starting perekop"

    check_requirements

    migration

    config_foreach process_validate_service "section"

    br_netfilter_disable

    # Sync time for TLS
    /usr/sbin/ntpd -q -p 194.190.168.1 -p 216.239.35.0 -p 216.239.35.4 -p 162.159.200.1 -p 162.159.200.123

    sleep 1

    mkdir -p "$TMP_XRAY_FOLDER"
    mkdir -p "$TMP_LISTS_FOLDER"
    mkdir -p "$TMP_RULESET_FOLDER"
    mkdir -p "$TMP_LISTS_FOLDER/matchers"

    # base
    route_table_rule_mark
    create_nft_rules
    xray_configure_service

    # Lists must exist before the config is built: /tmp is wiped on reboot,
    # so on the first start after a boot the lists are downloaded synchronously
    if ! lists_initialized; then
        log "Lists are missing, downloading them before the first start" "debug"
        list_update
    fi

    # xray
    xray_init_config
    config_foreach add_cron_job "section"
    /etc/init.d/xray start
    xray_apply_balancer_overrides

    log "Nice"
    list_update &
    echo $! > /var/run/perekop_list_update.pid
}

stop_main() {
    log "Stopping the perekop"

    if [ -f /var/run/perekop_list_update.pid ]; then
        pid=$(cat /var/run/perekop_list_update.pid)
        if kill -0 "$pid" 2> /dev/null; then
            kill "$pid" 2> /dev/null
            log "Stopped list_update"
        fi
        rm -f /var/run/perekop_list_update.pid
    fi

    remove_cron_job

    rm -f "$TMP_RULESET_FOLDER"/*

    log "Flush nft"
    if nft list table inet "$NFT_TABLE_NAME" > /dev/null 2>&1; then
        nft delete table inet "$NFT_TABLE_NAME"
    fi

    log "Flush ip rule"
    if ip rule list | grep -q "perekop"; then
        ip rule del fwmark "$NFT_FAKEIP_MARK"/"$NFT_FAKEIP_MARK" table "$RT_TABLE_NAME" priority 105
    fi

    log "Flush ip route"
    if ip route list table "$RT_TABLE_NAME" > /dev/null 2>&1; then
        ip route flush table "$RT_TABLE_NAME"
    fi

    log "Stop xray"
    /etc/init.d/xray stop
}

start() {
    start_main

    config_get_bool dont_touch_dhcp "settings" "dont_touch_dhcp" 0
    if [ "$dont_touch_dhcp" -eq 0 ]; then
        dnsmasq_configure
    fi

    uci_set "perekop" "settings" "shutdown_correctly" 0
    uci commit "perekop" && config_load "$PEREKOP_CONFIG"
}

stop() {
    local dont_touch_dhcp
    config_get_bool dont_touch_dhcp "settings" "dont_touch_dhcp" 0
    if [ "$dont_touch_dhcp" -eq 0 ]; then
        dnsmasq_restore
    fi

    stop_main

    uci_set "perekop" "settings" "shutdown_correctly" 1
    uci commit "perekop" && config_load "$PEREKOP_CONFIG"
}

reload() {
    log "Perekop reload"
    stop_main
    start_main
}

restart() {
    log "Perekop restart"
    stop
    start
}

# Migrations and validation funcs
migration() {
    # Options of sing-box features that have no Xray analogs
    uci -q delete perekop.settings.enable_yacd
    uci -q delete perekop.settings.enable_yacd_wan_access
    uci -q delete perekop.settings.yacd_secret_key
    uci -q delete perekop.settings.enable_utls_fallback
    uci -q delete perekop.settings.cache_path
    uci -q delete perekop.settings.dns_rewrite_ttl
    uci -q commit perekop
}

validate_service() {
    local service="$1"

    for community_service in $COMMUNITY_SERVICES; do
        if [ "$service" = "$community_service" ]; then
            return 0
        fi
    done

    log "Invalid service in community lists: $service. Check config and LuCI cache. Aborted." "fatal"
    exit 1
}

process_validate_service() {
    local section="$1"
    local community_lists
    config_get community_lists "$section" "community_lists"
    if [ -n "$community_lists" ]; then
        config_list_foreach "$section" "community_lists" validate_service
    fi
}

br_netfilter_disable() {
    if lsmod | grep -q br_netfilter && [ "$(sysctl -n net.bridge.bridge-nf-call-iptables 2> /dev/null)" = "1" ]; then
        log "br_netfilter enabled detected. Disabling"
        sysctl -w net.bridge.bridge-nf-call-iptables=0
        sysctl -w net.bridge.bridge-nf-call-ip6tables=0
    fi
}

route_table_rule_mark() {
    grep -q "105 $RT_TABLE_NAME" /etc/iproute2/rt_tables || echo "105 $RT_TABLE_NAME" >> /etc/iproute2/rt_tables

    if ! ip route list table "$RT_TABLE_NAME" 2> /dev/null | grep -q "local default dev lo scope host"; then
        log "Added route for tproxy" "debug"
        ip route add local 0.0.0.0/0 dev lo table "$RT_TABLE_NAME"
    else
        log "Route for tproxy exists" "debug"
    fi

    if ! ip rule list | grep -q "from all fwmark $NFT_FAKEIP_MARK/$NFT_FAKEIP_MARK lookup $RT_TABLE_NAME"; then
        log "Create marking rule" "debug"
        ip -4 rule add fwmark "$NFT_FAKEIP_MARK"/"$NFT_FAKEIP_MARK" table "$RT_TABLE_NAME" priority 105
    else
        log "Marking rule exist" "debug"
    fi
}

nft_init_interfaces_set() {
    nft_create_ifname_set "$NFT_TABLE_NAME" "$NFT_INTERFACE_SET_NAME"

    local source_network_interfaces
    config_get source_network_interfaces "settings" "source_network_interfaces" "br-lan"

    for interface in $source_network_interfaces; do
        nft add element inet "$NFT_TABLE_NAME" "$NFT_INTERFACE_SET_NAME" "{ $interface }"
    done
}

create_nft_rules() {
    log "Create nft table"
    nft_create_table "$NFT_TABLE_NAME"

    log "Create localv4 set"
    nft_create_ipv4_set "$NFT_TABLE_NAME" "$NFT_LOCALV4_SET_NAME"
    nft add element inet "$NFT_TABLE_NAME" localv4 '{
        0.0.0.0/8,
        10.0.0.0/8,
        127.0.0.0/8,
        169.254.0.0/16,
        172.16.0.0/12,
        192.0.0.0/24,
        192.0.2.0/24,
        192.88.99.0/24,
        192.168.0.0/16,
        198.51.100.0/24,
        203.0.113.0/24,
        224.0.0.0/4,
        240.0.0.0-255.255.255.255
    }'

    log "Create common set"
    nft_create_ipv4_set "$NFT_TABLE_NAME" "$NFT_COMMON_SET_NAME"

    log "Create interface set"
    nft_init_interfaces_set

    log "Create nft rules"
    nft add chain inet "$NFT_TABLE_NAME" mangle '{ type filter hook prerouting priority -150; policy accept; }'
    nft add chain inet "$NFT_TABLE_NAME" mangle_output '{ type route hook output priority -150; policy accept; }'
    nft add chain inet "$NFT_TABLE_NAME" proxy '{ type filter hook prerouting priority -100; policy accept; }'

    nft add rule inet "$NFT_TABLE_NAME" mangle ct status dnat return
    nft add rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" ip daddr "@$NFT_COMMON_SET_NAME" meta l4proto tcp meta mark set "$NFT_FAKEIP_MARK" counter
    nft add rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" ip daddr "@$NFT_COMMON_SET_NAME" meta l4proto udp meta mark set "$NFT_FAKEIP_MARK" counter
    nft add rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" ip daddr "$XRAY_FAKEIP_INET4_RANGE" meta l4proto tcp meta mark set "$NFT_FAKEIP_MARK" counter
    nft add rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" ip daddr "$XRAY_FAKEIP_INET4_RANGE" meta l4proto udp meta mark set "$NFT_FAKEIP_MARK" counter

    nft add rule inet "$NFT_TABLE_NAME" proxy meta mark \& "$NFT_FAKEIP_MARK" == "$NFT_FAKEIP_MARK" meta l4proto tcp tproxy ip to 127.0.0.1:1602 counter
    nft add rule inet "$NFT_TABLE_NAME" proxy meta mark \& "$NFT_FAKEIP_MARK" == "$NFT_FAKEIP_MARK" meta l4proto udp tproxy ip to 127.0.0.1:1602 counter

    nft add rule inet "$NFT_TABLE_NAME" mangle_output ip daddr "@$NFT_LOCALV4_SET_NAME" return
    nft add rule inet "$NFT_TABLE_NAME" mangle_output meta mark "$NFT_OUTBOUND_MARK" counter return
    nft add rule inet "$NFT_TABLE_NAME" mangle_output ip daddr "@$NFT_COMMON_SET_NAME" meta l4proto tcp meta mark set "$NFT_FAKEIP_MARK" counter
    nft add rule inet "$NFT_TABLE_NAME" mangle_output ip daddr "@$NFT_COMMON_SET_NAME" meta l4proto udp meta mark set "$NFT_FAKEIP_MARK" counter
    nft add rule inet "$NFT_TABLE_NAME" mangle_output ip daddr "$XRAY_FAKEIP_INET4_RANGE" meta l4proto tcp meta mark set "$NFT_FAKEIP_MARK" counter
    nft add rule inet "$NFT_TABLE_NAME" mangle_output ip daddr "$XRAY_FAKEIP_INET4_RANGE" meta l4proto udp meta mark set "$NFT_FAKEIP_MARK" counter

    local exclude_ntp
    config_get_bool exclude_ntp "settings" "exclude_ntp" "0"
    if [ "$exclude_ntp" -eq 1 ]; then
        log "NTP traffic exclude for proxy"
        nft insert rule inet "$NFT_TABLE_NAME" mangle udp dport 123 return
    fi
}

backup_dnsmasq_config_option() {
    local key="$1"
    local backup_key="$2"
    local value
    value="$(uci_get "dhcp" "@dnsmasq[0]" "$key")"

    if [ -n "$value" ]; then
        uci_set "dhcp" "@dnsmasq[0]" "$backup_key" "$value"
    fi
}

dnsmasq_configure() {
    local shutdown_correctly
    config_get shutdown_correctly "settings" "shutdown_correctly"
    if [ "$shutdown_correctly" -eq 0 ]; then
        log "Previous shutdown of perekop was not correct, reconfiguration of dnsmasq is not required"
        return 0
    fi

    log "Backup dnsmasq configuration"
    current_servers="$(uci_get "dhcp" "@dnsmasq[0]" "server")"
    if [ -n "$current_servers" ]; then
        for server in $(uci_get "dhcp" "@dnsmasq[0]" "server"); do
            if ! [ "$server" == "$XRAY_DNS_INBOUND_ADDRESS" ]; then
                uci_add_list "dhcp" "@dnsmasq[0]" "perekop_server" "$server"
            fi
        done
        uci_remove "dhcp" "@dnsmasq[0]" "server"
    fi

    backup_dnsmasq_config_option "noresolv" "perekop_noresolv"
    backup_dnsmasq_config_option "cachesize" "perekop_cachesize"

    # Backup the address list and pin the FakeIP check domain to a fake IP,
    # so that traffic to it enters the core and is redirected to the real
    # service on port 8443 (the port override of podkop)
    current_addresses="$(uci_get "dhcp" "@dnsmasq[0]" "address")"
    if [ -n "$current_addresses" ]; then
        for address in $current_addresses; do
            if ! [ "$address" == "/$FAKEIP_TEST_DOMAIN/$FAKEIP_TEST_LOCAL_IP" ]; then
                uci_add_list "dhcp" "@dnsmasq[0]" "perekop_address" "$address"
            fi
        done
        uci_remove "dhcp" "@dnsmasq[0]" "address"
    fi

    log "Configure dnsmasq for xray"
    uci_add_list "dhcp" "@dnsmasq[0]" "server" "$XRAY_DNS_INBOUND_ADDRESS"
    uci_add_list "dhcp" "@dnsmasq[0]" "address" "/$FAKEIP_TEST_DOMAIN/$FAKEIP_TEST_LOCAL_IP"
    uci_set "dhcp" "@dnsmasq[0]" "noresolv" 1
    uci_set "dhcp" "@dnsmasq[0]" "cachesize" 0
    uci_commit "dhcp"

    /etc/init.d/dnsmasq restart
}

dnsmasq_restore() {
    log "Restoring the dnsmasq configuration"
    local shutdown_correctly
    config_get shutdown_correctly "settings" "shutdown_correctly"
    if [ "$shutdown_correctly" -eq 1 ]; then
        log "Previous shutdown of perekop was correct, reconfiguration of dnsmasq is not required"
        return 0
    fi

    local cachesize noresolv backup_servers resolvfile
    log "Restoring cachesize" "debug"
    cachesize="$(uci_get "dhcp" "@dnsmasq[0]" "perekop_cachesize")"
    if [ -z "$cachesize" ]; then
        uci_remove "dhcp" "@dnsmasq[0]" "cachesize"
        uci_set "dhcp" "@dnsmasq[0]" "cachesize" 150
    else
        uci_set "dhcp" "@dnsmasq[0]" "cachesize" "$cachesize"
        uci_remove "dhcp" "@dnsmasq[0]" "perekop_cachesize"
    fi

    log "Restoring noresolv" "debug"
    noresolv="$(uci_get "dhcp" "@dnsmasq[0]" "perekop_noresolv")"
    if [ -z "$noresolv" ]; then
        uci_set "dhcp" "@dnsmasq[0]" "noresolv" 0
    else
        uci_set "dhcp" "@dnsmasq[0]" "noresolv" "$noresolv"
        uci_remove "dhcp" "@dnsmasq[0]" "perekop_noresolv"
    fi

    log "Restoring DNS servers" "debug"
    uci_remove "dhcp" "@dnsmasq[0]" "server"
    resolvfile="/tmp/resolv.conf.d/resolv.conf.auto"
    backup_servers="$(uci_get "dhcp" "@dnsmasq[0]" "perekop_server")"
    if [ -n "$backup_servers" ]; then
        for server in $backup_servers; do
            uci_add_list "dhcp" "@dnsmasq[0]" "server" "$server"
        done
        uci_remove "dhcp" "@dnsmasq[0]" "perekop_server"
    elif file_exists "$resolvfile"; then
        log "Backup DNS servers not found, using default resolvfile" "debug"
        uci_set "dhcp" "@dnsmasq[0]" "resolvfile" "$resolvfile"
        if [ -n "$noresolv" ] && [ "$noresolv" -eq 1 ]; then
            log "Disabling noresolv option to use system resolvfile" "debug"
            uci_set "dhcp" "@dnsmasq[0]" "noresolv" 0
        fi
    else
        log "Backup DNS servers and default resolvfile not found, possible resolving issues" "warn"
    fi

    log "Restoring dnsmasq addresses" "debug"
    uci_remove "dhcp" "@dnsmasq[0]" "address"
    backup_addresses="$(uci_get "dhcp" "@dnsmasq[0]" "perekop_address")"
    if [ -n "$backup_addresses" ]; then
        for address in $backup_addresses; do
            uci_add_list "dhcp" "@dnsmasq[0]" "address" "$address"
        done
        uci_remove "dhcp" "@dnsmasq[0]" "perekop_address"
    fi

    uci_commit "dhcp"

    /etc/init.d/dnsmasq restart
}

add_cron_job() {
    local community_lists remote_domain_lists remote_subnet_lists update_interval cron_job
    config_get community_lists "$section" "community_lists"
    config_get remote_domain_lists "$section" "remote_domain_lists"
    config_get remote_subnet_lists "$section" "remote_subnet_lists"
    config_get update_interval "settings" "update_interval"

    case "$update_interval" in
    "1h")
        cron_job="13 * * * * /usr/bin/perekop list_update"
        ;;
    "3h")
        cron_job="13 */3 * * * /usr/bin/perekop list_update"
        ;;
    "12h")
        cron_job="13 */12 * * * /usr/bin/perekop list_update"
        ;;
    "1d")
        cron_job="13 9 * * * /usr/bin/perekop list_update"
        ;;
    "3d")
        cron_job="13 9 */3 * * * /usr/bin/perekop list_update"
        ;;
    *)
        log "Invalid update_interval value: $update_interval"
        return
        ;;
    esac

    if [ -n "$community_lists" ] ||
        [ -n "$remote_domain_lists" ] ||
        [ -n "$remote_subnet_lists" ]; then
        remove_cron_job
        crontab -l | {
            cat
            echo "$cron_job"
        } | crontab -
        log "The cron job has been created: $cron_job"
    fi
}

remove_cron_job() {
    (crontab -l | grep -v "/usr/bin/perekop list_update") | crontab -
    log "The cron job removed"
}


# Downloads lists. Called synchronously at the first start after a boot
# (when /tmp is empty) and from cron in the background afterwards.
# After the download completes, the xray config is regenerated and the core
# is restarted, but only when the downloaded content actually changed:
# Xray reads inline lists and geosite.dat at startup only, unlike sing-box
# which updates rule sets itself.
list_update() {
    echolog "🔄 Starting lists update..."

    local nslookup_timeout=3
    local nslookup_attempts=10
    local curl_timeout=5
    local curl_attempts=10
    local curl_max_timeout=10
    local delay=3
    local i

    # DNS Check
    for i in $(seq 1 $nslookup_attempts); do
        if nslookup -timeout=$nslookup_timeout openwrt.org > /dev/null 2>&1; then
            echolog "✅ DNS check passed"
            break
        fi
        echolog "DNS is unavailable [$i/$nslookup_attempts]"
        sleep $delay
    done

    if [ "$i" -eq "$nslookup_attempts" ]; then
        echolog "❌ DNS check failed after $nslookup_attempts attempts"
        return 1
    fi

    # Github Check
    for i in $(seq 1 $curl_attempts); do
        if [ -n "$(get_service_proxy_address)" ]; then
            if curl -s --socks5-hostname "127.0.0.1:$XRAY_SERVICE_SOCKS_INBOUND_PORT" -m $curl_timeout https://github.com > /dev/null; then
                echolog "✅ GitHub connection check passed (via proxy)"
                break
            fi
        else
            if curl -s -m $curl_timeout https://github.com > /dev/null; then
                echolog "✅ GitHub connection check passed"
                break
            fi
        fi

        echolog "GitHub is unavailable [$i/$curl_attempts] (max-timeout=$curl_timeout)"
        if [ "$curl_timeout" -lt "$curl_max_timeout" ]; then
            curl_timeout=$((curl_timeout + 1))
        fi
        sleep $delay
    done

    if [ "$i" -eq "$curl_attempts" ]; then
        echolog "❌ GitHub connection check failed after $curl_attempts attempts"
        return 1
    fi

    echolog "📥 Downloading and processing lists..."

    config_foreach import_community_subnet_lists "section"
    download_geosite
    config_foreach import_domains_from_remote_domain_lists "section"
    config_foreach import_subnets_from_remote_subnet_lists "section"
    config_foreach import_local_lists "section"

    xray_reload_if_lists_changed

    echolog "✅ Lists update completed successfully"
}

lists_initialized() {
    [ -f "$TMP_LISTS_FOLDER/.initialized" ]
}

mark_lists_initialized() {
    touch "$TMP_LISTS_FOLDER/.initialized"
    lists_state_hash > "$GEOFILES_STATE"
}

lists_state_hash() {
    (
        cd "$TMP_XRAY_FOLDER" 2> /dev/null || return 1
        # The state file itself must not be part of the hash, or the hash
        # never stabilizes and the core restarts on every list update
        find . -type f ! -name .initialized ! -name "$(basename "$GEOFILES_STATE")" -print0 |
            sort -z | xargs -0 md5sum 2> /dev/null | md5sum | cut -d' ' -f1
    )
}

xray_reload_if_lists_changed() {
    local new_hash
    new_hash=$(lists_state_hash)

    if [ -z "$new_hash" ]; then
        echolog "❌ Cannot compute the lists state hash"
        return 1
    fi

    if [ ! -f "$GEOFILES_STATE" ] || [ "$(cat "$GEOFILES_STATE")" != "$new_hash" ]; then
        mark_lists_initialized
        if pgrep -f "xray run" > /dev/null 2>&1; then
            echolog "♻️ Lists changed, regenerating the xray config and restarting the core"
            xray_init_config
            /etc/init.d/xray restart
        fi
    else
        mark_lists_initialized
        echolog "Lists did not change, the core is not restarted"
    fi
}

download_geosite() {
    local community_lists_geosite_needed=0

    any_community_domain_lists() {
        local section="$1"
        local community_lists
        config_get community_lists "$section" "community_lists"
        [ -n "$community_lists" ] && community_lists_geosite_needed=1
    }
    config_foreach any_community_domain_lists "section"

    if [ "$community_lists_geosite_needed" -eq 0 ]; then
        return 0
    fi

    local tmpfile http_proxy_address
    tmpfile=$(mktemp)
    http_proxy_address="$(get_service_proxy_address)"

    if download_to_file "$GEOSITE_URL" "$tmpfile" "$http_proxy_address"; then
        if [ -s "$tmpfile" ]; then
            mv "$tmpfile" "$TMP_XRAY_FOLDER/geosite.dat"
            echolog "✅ geosite.dat downloaded"
            return 0
        fi
    fi

    rm -f "$tmpfile"

    if [ -f "$TMP_XRAY_FOLDER/geosite.dat" ]; then
        echolog "⚠️ geosite.dat download failed, keeping the previous version"
    else
        echolog "❌ geosite.dat download failed"
    fi

    return 1
}

# Downloads a list and normalizes it to a plain one-entry-per-line file.
# Arguments:
#   $1 - URL
#   $2 - destination file
# Returns:
#   0 on success, 1 on failure
download_normalized_list() {
    local url="$1"
    local output_filepath="$2"
    local http_proxy_address tmpfile file_extension

    http_proxy_address="$(get_service_proxy_address)"
    tmpfile=$(mktemp)

    download_to_file "$url" "$tmpfile" "$http_proxy_address"

    if [ $? -ne 0 ] || [ ! -s "$tmpfile" ]; then
        log "Download $url list failed" "error"
        rm -f "$tmpfile"
        return 1
    fi

    convert_crlf_to_lf "$tmpfile"

    file_extension=$(url_get_file_extension "$url")
    case "$file_extension" in
    json)
        # sing-box source rule set: extract domain and subnet rules to plain lists
        jq -r '
            .rules[] |
            (.domain_suffix[]? | "domain:\(.)"),
            (.domain[]? | "full:\(.)"),
            (.domain_keyword[]? | "keyword:\(.)"),
            (.domain_regexp[]? | "regexp:\(.)"),
            (.ip_cidr[]? | "\(.)")
        ' "$tmpfile" > "$output_filepath" 2>/dev/null || {
            log "Failed to extract rules from the JSON list $url" "error"
            rm -f "$tmpfile"
            return 1
        }
        ;;
    srs)
        log "The .srs format is not supported by perekop (Xray cannot read sing-box binary rule sets). Use a plain text or .json list" "error"
        rm -f "$tmpfile"
        return 1
        ;;
    *)
        grep -v '^[[:space:]]*$' "$tmpfile" | grep -v '^//' > "$output_filepath"
        ;;
    esac

    rm -f "$tmpfile"
    return 0
}

import_community_subnet_lists() {
    local section="$1"
    local community_lists
    config_get community_lists "$section" "community_lists"
    if [ -n "$community_lists" ]; then
        log "Importing community subnet lists for '$section' section"
        config_list_foreach "$section" "community_lists" import_community_service_subnet_list_handler
    fi
}

import_community_service_subnet_list_handler() {
    local service="$1"

    case "$service" in
    "twitter")
        URL=$SUBNETS_TWITTER
        ;;
    "meta")
        URL=$SUBNETS_META
        ;;
    "telegram")
        URL=$SUBNETS_TELERAM
        ;;
    "cloudflare")
        URL=$SUBNETS_CLOUDFLARE
        ;;
    "hetzner")
        URL=$SUBNETS_HETZNER
        ;;
    "ovh")
        URL=$SUBNETS_OVH
        ;;
    "digitalocean")
        URL=$SUBNETS_DIGITALOCEAN
        ;;
    "cloudfront")
        URL=$SUBNETS_CLOUDFRONT
        ;;
    "discord")
        URL=$SUBNETS_DISCORD
        nft_create_ipv4_set "$NFT_TABLE_NAME" "$NFT_DISCORD_SET_NAME"
        nft add rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" ip daddr \
            "@$NFT_DISCORD_SET_NAME" udp dport '{ 19000-20000, 50000-65535 }' meta mark set "$NFT_FAKEIP_MARK" counter
        ;;
    "roblox")
        URL=$SUBNETS_ROBLOX
        ;;
    *) return 0 ;;
    esac

    local tmpfile http_proxy_address
    tmpfile=$(mktemp)
    http_proxy_address="$(get_service_proxy_address)"

    download_to_file "$URL" "$tmpfile" "$http_proxy_address"

    if [ $? -ne 0 ] || [ ! -s "$tmpfile" ]; then
        log "Download $service list failed" "error"
        return 1
    fi

    if [ "$service" = "discord" ]; then
        nft_add_set_elements_from_file_chunked "$tmpfile" "$NFT_TABLE_NAME" "$NFT_DISCORD_SET_NAME"
    else
        nft_add_set_elements_from_file_chunked "$tmpfile" "$NFT_TABLE_NAME" "$NFT_COMMON_SET_NAME"
    fi

    rm -f "$tmpfile"
}

import_domains_from_remote_domain_lists() {
    local section="$1"
    local remote_domain_lists
    config_get remote_domain_lists "$section" "remote_domain_lists"
    if [ -n "$remote_domain_lists" ]; then
        log "Importing domains from remote domain lists for '$section' section"
        config_list_foreach "$section" "remote_domain_lists" import_domains_from_remote_domain_list_handler "$section"
    fi
}

import_domains_from_remote_domain_list_handler() {
    local url="$1"
    local section="$2"

    log "Importing domains from URL: $url" "debug"

    local basename
    basename=$(url_get_basename "$url")

    download_normalized_list "$url" "$TMP_LISTS_FOLDER/remote-$section-$basename.lst"
}

import_subnets_from_remote_subnet_lists() {
    local section="$1"
    local remote_subnet_lists
    config_get remote_subnet_lists "$section" "remote_subnet_lists"
    if [ -n "$remote_subnet_lists" ]; then
        log "Importing subnets from remote subnet lists for '$section' section"
        config_list_foreach "$section" "remote_subnet_lists" import_subnets_from_remote_subnet_list_handler "$section"
    fi
}

import_subnets_from_remote_subnet_list_handler() {
    local url="$1"
    local section="$2"

    log "Importing subnets from URL: $url" "debug"

    local basename tmpfile
    basename=$(url_get_basename "$url")
    tmpfile=$(mktemp)

    download_normalized_list "$url" "$tmpfile" || {
        rm -f "$tmpfile"
        return 1
    }

    nft_add_set_elements_from_file_chunked "$tmpfile" "$NFT_TABLE_NAME" "$NFT_COMMON_SET_NAME"
    mv "$tmpfile" "$TMP_LISTS_FOLDER/remote-$section-$basename.lst"
}

import_local_lists() {
    local section="$1"
    local local_domain_lists local_subnet_lists

    config_get local_domain_lists "$section" "local_domain_lists"
    config_get local_subnet_lists "$section" "local_subnet_lists"

    if [ -n "$local_domain_lists" ]; then
        log "Importing local domain lists for '$section' section"
        config_list_foreach "$section" "local_domain_lists" import_local_list_handler "domains" "$section"
    fi

    if [ -n "$local_subnet_lists" ]; then
        log "Importing local subnet lists for '$section' section"
        config_list_foreach "$section" "local_subnet_lists" import_local_list_handler "subnets" "$section"
    fi
}

import_local_list_handler() {
    local local_list_filepath="$1"
    local type="$2"
    local section="$3"

    if ! file_exists "$local_list_filepath"; then
        log "Local list file $local_list_filepath not found" "error"
        return 1
    fi

    local destination="$TMP_LISTS_FOLDER/local-$section-$(basename "$local_list_filepath")"

    if [ "$type" = "subnets" ]; then
        nft_add_set_elements_from_file_chunked "$local_list_filepath" "$NFT_TABLE_NAME" "$NFT_COMMON_SET_NAME"
    fi

    cp "$local_list_filepath" "$destination"
}

## Support functions
get_service_proxy_address() {
    local download_lists_via_proxy
    config_get_bool download_lists_via_proxy "settings" "download_lists_via_proxy" 0
    if [ "$download_lists_via_proxy" -eq 1 ]; then
        echo "$XRAY_SERVICE_SOCKS_INBOUND_ADDRESS:$XRAY_SERVICE_SOCKS_INBOUND_PORT"
    else
        echo ""
    fi
}

get_download_detour_tag() {
    config_get_bool download_lists_via_proxy "settings" "download_lists_via_proxy" 0
    if [ "$download_lists_via_proxy" -eq 1 ]; then
        local download_lists_via_proxy_section
        config_get download_lists_via_proxy_section "settings" "download_lists_via_proxy_section"
        get_outbound_tag_by_section "$download_lists_via_proxy_section"
    else
        echo ""
    fi
}

_determine_first_outbound_section() {
    local section="$1"

    local connection_type
    config_get connection_type "$section" "connection_type"

    # A VPN outbound cannot resolve the check domain: only proxy sections
    # are suitable for the check traffic
    if [ "$connection_type" = "proxy" ]; then
        [ -z "$first_section" ] && first_section="$1"
    fi
}

get_first_outbound_section() {
    local first_section=""

    config_foreach _determine_first_outbound_section "section"

    echo "$first_section"
}

get_sections_by_connection_type() {
    local connection_type="$1"

    uci show perekop | grep "\.connection_type='$connection_type'" | cut -d'.' -f2
}

section_by_connection_type_exists() {
    local connection_type="$1"

    if uci show perekop | grep -q "\.connection_type='$connection_type'"; then
        return 0
    else
        return 1
    fi
}

section_has_enabled_lists() {
    local section="$1"
    local community_lists user_domain_list_type user_subnet_list_type local_domain_lists local_subnet_lists \
        remote_domain_lists remote_subnet_lists

    config_get community_lists "$section" "community_lists"
    config_get user_domain_list_type "$section" "user_domain_list_type" "disabled"
    config_get user_subnet_list_type "$section" "user_subnet_list_type" "disabled"
    config_get local_domain_lists "$section" "local_domain_lists"
    config_get local_subnet_lists "$section" "local_subnet_lists"
    config_get remote_domain_lists "$section" "remote_domain_lists"
    config_get remote_subnet_lists "$section" "remote_subnet_lists"

    if [ -n "$community_lists" ] ||
        [ "$user_domain_list_type" != "disabled" ] ||
        [ "$user_subnet_list_type" != "disabled" ] ||
        [ -n "$local_domain_lists" ] ||
        [ -n "$local_subnet_lists" ] ||
        [ -n "$remote_domain_lists" ] ||
        [ -n "$remote_subnet_lists" ]; then
        return 0
    else
        return 1
    fi
}

get_service_listen_address() {
    local service_listen_address

    config_get service_listen_address "settings" "service_listen_address"
    if [ -n "$service_listen_address" ]; then
        log "Attention! The service_listen_address option is being used, overriding the automatic detection of the listening IP address!" "warn"
        echo "$service_listen_address"
        return 0
    fi

    local interface="lan"
    network_get_ipaddr service_listen_address "$interface"

    if [ -z "$service_listen_address" ]; then
        log "Failed to determine the listening IP address. Please open an issue to report this problem: https://github.com/itdoginfo/perekop/issues" "error"
        return 1
    fi

    echo "$service_listen_address"
}
nft_list_all_traffic_from_ip() {
    local ip="$1"

    if ! nft list chain inet "$NFT_TABLE_NAME" mangle | grep -q "ip saddr $ip"; then
        nft insert rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" ip saddr "$ip" \
            meta l4proto tcp meta mark set "$NFT_FAKEIP_MARK" counter
        nft insert rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" ip saddr "$ip" \
            meta l4proto udp meta mark set "$NFT_FAKEIP_MARK" counter
        nft insert rule inet "$NFT_TABLE_NAME" mangle ip saddr "$ip" ip daddr @localv4 return
    fi
}

# xray funcs
xray_configure_service() {
    local xray_enabled xray_datadir xray_conffiles xray_config_path xray_memlimit

    xray_enabled="$(uci -q get xray.enabled.enabled)"
    if [ "$xray_enabled" != "1" ]; then
        uci_set "xray" "enabled" "enabled" 1
        uci_commit "xray"
        log "xray service has been enabled"
    fi

    xray_datadir="$(uci -q get xray.config.datadir)"
    if [ "$xray_datadir" != "$TMP_XRAY_FOLDER" ]; then
        uci_set "xray" "config" "datadir" "$TMP_XRAY_FOLDER"
        uci_commit "xray"
        log "xray asset dir has been set to $TMP_XRAY_FOLDER"
    fi

    config_get xray_config_path "settings" "config_path" "/etc/xray/config.json"
    xray_conffiles="$(uci -q get xray.config.conffiles)"
    if [ "$xray_conffiles" != "$xray_config_path" ]; then
        uci -q delete xray.config.conffiles
        uci add_list "xray.config.conffiles=$xray_config_path"
        uci_commit "xray"
        log "Configuration file path has been set to $xray_config_path"
    fi

    # Go respects the soft GOMEMLIMIT limit: the runtime keeps the heap
    # under it and collects garbage more aggressively instead of growing
    # until the router runs out of memory. A hard rlimit cannot be used:
    # Go reserves gigabytes of address space and would fail to start
    config_get xray_memlimit "settings" "xray_memlimit" "25"
    if [ -n "$xray_memlimit" ] && [ "$xray_memlimit" != "0" ]; then
        if [ "$(uci -q get xray.config.memlimit)" != "$xray_memlimit" ]; then
            uci_set "xray" "config" "memlimit" "$xray_memlimit"
            uci_commit "xray"
        fi
        xray_patch_init_memlimit
    else
        [ -n "$(uci -q get xray.config.memlimit)" ] && {
            uci -q delete xray.config.memlimit
            uci_commit "xray"
        }
        xray_restore_init_memlimit
    fi

    [ -f /etc/rc.d/S99xray ] && log "Disable xray autostart" && /etc/init.d/xray disable
}

# The xray-core package owns /etc/init.d/xray and does not read the
# memlimit from uci, so the init script is patched in place. procd
# replaces the whole env on a repeated procd_set_param env call, so the
# patch rewrites the asset line to pass both variables in one call.
# The patch is idempotent and re-applied on every start: a xray-core
# upgrade replaces the file and the next start heals it again
xray_patch_init_memlimit() {
    grep -q "GOMEMLIMIT" /etc/init.d/xray 2>/dev/null && return 0

    awk '
        /procd_set_param env XRAY_LOCATION_ASSET=/ && !done {
            done = 1
            print "\tconfig_get memlimit \"config\" \"memlimit\""
            print "\tif [ -n \"$memlimit\" ]; then"
            print "\t\tprocd_set_param env XRAY_LOCATION_ASSET=\"$datadir\" GOMEMLIMIT=\"${memlimit}MiB\""
            print "\telse"
            print "\t\tprocd_set_param env XRAY_LOCATION_ASSET=\"$datadir\""
            print "\tfi"
            next
        }
        { print }
    ' /etc/init.d/xray > /etc/init.d/xray.tmp &&
        mv /etc/init.d/xray.tmp /etc/init.d/xray &&
        chmod +x /etc/init.d/xray

    log "xray init script patched with GOMEMLIMIT support" "debug"
}

xray_restore_init_memlimit() {
    [ -f /etc/init.d/xray ] || return 0
    grep -q "GOMEMLIMIT" /etc/init.d/xray || return 0

    awk '
        /config_get memlimit "config" "memlimit"/ { skip = 1; print "\tprocd_set_param env XRAY_LOCATION_ASSET=\"$datadir\""; next }
        skip && /^	}$/ { skip = 0; next }
        !skip { print }
    ' /etc/init.d/xray > /etc/init.d/xray.tmp &&
        mv /etc/init.d/xray.tmp /etc/init.d/xray &&
        chmod +x /etc/init.d/xray
}

xray_init_config() {
    local config
    config=$(xray_cm_init_config)

    mkdir -p "$TMP_LISTS_FOLDER/matchers"
    rm -f "$TMP_LISTS_FOLDER/matchers"/*

    collect_section_matchers

    xray_configure_log
    xray_configure_inbounds
    xray_configure_outbounds
    xray_configure_dns
    xray_configure_route
    xray_configure_experimental
    xray_save_config
}

xray_configure_log() {
    log "Configure the log section of an Xray JSON configuration" "debug"

    local log_level
    config_get log_level "settings" "log_level" "warning"
    config=$(xray_cm_configure_log "$config" "$log_level")
}

xray_configure_inbounds() {
    log "Configure the inbounds section of an Xray JSON configuration" "debug"

    # TProxy inbound: fakedns sniffing restores the domain for fake IP targets
    config=$(xray_cm_add_inbound "$config" "$(jq -n \
        --arg tag "$XRAY_TPROXY_INBOUND_TAG" \
        --arg listen "$XRAY_TPROXY_INBOUND_ADDRESS" \
        --argjson port "$XRAY_TPROXY_INBOUND_PORT" \
        '{
            "listen": $listen,
            "port": $port,
            "protocol": "dokodemo-door",
            "settings": {"followRedirect": true, "network": "tcp,udp"},
            "sniffing": {"enabled": true, "destOverride": ["fakedns"]},
            "streamSettings": {"sockopt": {"tproxy": "tproxy"}},
            "tag": $tag
        }')")

    # DNS inbound: dnsmasq forwards all queries here. dokodemo-door needs a
    # destination even though the dns-out route rule ignores it: use the
    # configured upstream so a broken route still resolves instead of looping
    local dns_server dns_port
    config_get dns_server "settings" "dns_server" "77.88.8.8"
    dns_port=$(url_get_port "$dns_server")
    [ -z "$dns_port" ] && dns_port=53

    config=$(xray_cm_add_inbound "$config" "$(jq -n \
        --arg tag "$XRAY_DNS_INBOUND_TAG" \
        --arg listen "$XRAY_DNS_INBOUND_ADDRESS" \
        --argjson port "$XRAY_DNS_INBOUND_PORT" \
        --arg address "$(url_get_host "$dns_server")" \
        --argjson dns_port "$dns_port" \
        '{
            "listen": $listen,
            "port": $port,
            "protocol": "dokodemo-door",
            "settings": {"address": $address, "port": $dns_port, "network": "tcp,udp"},
            "tag": $tag
        }')")

    xray_configure_latency_socks
}

_print_proxy_section() {
    local section="$1"
    local connection_type
    config_get connection_type "$section" "connection_type"
    [ "$connection_type" = "proxy" ] && echo "$section"
}

get_latency_socks_port() {
    local target="$1"
    local port=$((XRAY_LATENCY_SOCKS_BASE_PORT - 1)) section
    for section in $(config_foreach _print_proxy_section "section"); do
        port=$((port + 1))
        [ "$section" = "$target" ] && { echo "$port"; return 0; }
    done
    echo ""
}

# One loopback SOCKS inbound per proxy section, routed to the section
# balancer. The balancer override API then allows measuring the delay of
# every outbound of the group through this inbound. Single-link sections
# get a one-outbound balancer wrapper: the override is the only per
# outbound switch Xray offers
xray_configure_latency_socks() {
    local port=$((XRAY_LATENCY_SOCKS_BASE_PORT - 1)) section proxy_config_type balancer_tag
    for section in $(config_foreach _print_proxy_section "section"); do
        port=$((port + 1))
        config_get proxy_config_type "$section" "proxy_config_type"
        case "$proxy_config_type" in
        selector | urltest)
            balancer_tag="$(get_outbound_tag_by_section "$section")"
            ;;
        url | outbound)
            balancer_tag="$section-latency"
            config=$(xray_cm_add_balancer "$config" "$balancer_tag" \
                "$(get_outbound_tag_by_section "$section")" "random" "")
            ;;
        *)
            continue
            ;;
        esac

        config=$(xray_cm_add_inbound "$config" "$(jq -n \
            --arg tag "latency-$section" \
            --arg listen "$XRAY_LATENCY_SOCKS_INBOUND_ADDRESS" \
            --argjson port "$port" \
            '{
                "listen": $listen,
                "port": $port,
                "protocol": "socks",
                "settings": {"auth": "noauth", "udp": false},
                "tag": $tag
            }')")
        config=$(xray_cm_add_route_rule "$config" "$(jq -n \
            --arg tag "latency-$section" --arg balancer "$balancer_tag" \
            '{"inboundTag": [$tag], "balancerTag": $balancer}')")
    done
}

xray_configure_outbounds() {
    log "Configure the outbounds section of an Xray JSON configuration" "debug"

    # The first outbound is the default one for unmatched traffic
    config=$(xray_cm_add_outbound "$config" "$(xray_cm_build_freedom_outbound "$XRAY_DIRECT_OUTBOUND_TAG" "" "" "")")
    config=$(xray_cm_add_outbound "$config" "$(xray_cm_build_blackhole_outbound "$XRAY_BLACKHOLE_OUTBOUND_TAG")")
    config=$(xray_cm_add_outbound "$config" "$(xray_cm_build_dns_outbound "$XRAY_DNS_OUTBOUND_TAG")")

    xray_configure_fakeip_test_outbound

    config_foreach configure_outbound_handler "section"

    xray_configure_service_socks_inbound
}

xray_configure_fakeip_test_outbound() {
    local bootstrap_dns_server real_ip
    config_get bootstrap_dns_server "settings" "bootstrap_dns_server" "77.88.8.8"

    # Resolve directly via the bootstrap server, bypassing dnsmasq and the
    # core itself: the Freedom redirect must never dial a fake IP
    real_ip=$(dig +short +time=2 +tries=2 "@$bootstrap_dns_server" "$FAKEIP_TEST_DOMAIN" 2> /dev/null |
        grep -E "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" | head -n 1)

    if [ -n "$real_ip" ] && is_ipv4 "$real_ip"; then
        log "The FakeIP check domain resolves to $real_ip" "debug"
        config=$(xray_cm_add_outbound "$config" "$(xray_cf_build_fakeip_test_outbound "$real_ip")")
    else
        log "Cannot resolve the FakeIP check domain via $bootstrap_dns_server, the FakeIP check is disabled until the next start" "warn"
    fi
}

xray_configure_service_socks_inbound() {
    local download_lists_via_proxy
    config_get_bool download_lists_via_proxy "settings" "download_lists_via_proxy" 0
    if [ "$download_lists_via_proxy" -eq 1 ]; then
        local download_lists_via_proxy_section section_outbound_tag
        config_get download_lists_via_proxy_section "settings" "download_lists_via_proxy_section"
        section_outbound_tag="$(get_outbound_tag_by_section "$download_lists_via_proxy_section")"
        config=$(xray_cf_add_socks_inbound_and_route_rule "$config" \
            "$XRAY_SERVICE_SOCKS_INBOUND_TAG" \
            "$XRAY_SERVICE_SOCKS_INBOUND_ADDRESS" \
            "$XRAY_SERVICE_SOCKS_INBOUND_PORT" \
            "$section_outbound_tag")
    fi

    config_foreach configure_section_mixed_proxy "section"
}

configure_section_mixed_proxy() {
    local section="$1"

    local mixed_inbound_enabled mixed_proxy_port mixed_outbound_tag mixed_proxy_address
    config_get_bool mixed_inbound_enabled "$section" "mixed_proxy_enabled" 0
    if [ "$mixed_inbound_enabled" -ne 1 ]; then
        return 0
    fi

    mixed_proxy_address="$(get_service_listen_address)"
    if [ -z "$mixed_proxy_address" ]; then
        log "Could not determine the listening IP address for the SOCKS proxy. The proxy will not be created." "warn"
        return 1
    fi

    config_get mixed_proxy_port "$section" "mixed_proxy_port"

    # Xray has no combined inbound: SOCKS on the configured port, HTTP on the next one
    config=$(xray_cf_add_socks_inbound_and_route_rule "$config" \
        "$(get_inbound_tag_by_section "$section-mixed")" \
        "$mixed_proxy_address" \
        "$mixed_proxy_port" \
        "$(get_outbound_tag_by_section "$section")")

    local http_tag http_port
    http_tag="$(get_inbound_tag_by_section "$section-mixed-http")"
    http_port=$((mixed_proxy_port + 1))
    config=$(xray_cm_add_inbound "$config" "$(jq -n \
        --arg tag "$http_tag" --arg listen "$mixed_proxy_address" --argjson port "$http_port" \
        '{"listen": $listen, "port": $port, "protocol": "http", "settings": {}, "tag": $tag}')")
    config=$(xray_cm_add_route_rule "$config" "$(jq -n \
        --arg tag "$http_tag" --arg outbound "$(get_outbound_tag_by_section "$section")" \
        '{"inboundTag": [$tag], "outboundTag": $outbound}')")

    log "SOCKS proxy of the '$section' section on $mixed_proxy_address:$mixed_proxy_port, HTTP on $((mixed_proxy_port + 1))" "info"
}



#######################################
# Collect the domain and IP matchers of every section into
# $TMP_LISTS_FOLDER/matchers/<section>.domains.json and .ips.json.
# The files contain JSON arrays of Xray match strings
# ("domain:example.com", "ext:geosite.dat:TELEGRAM", CIDRs).
#######################################
collect_section_matchers() {
    config_foreach collect_matchers_for_section "section"
}

collect_matchers_for_section() {
    local section="$1"

    local domain_items=""
    local ip_items=""

    local community_lists
    config_get community_lists "$section" "community_lists"
    if [ -n "$community_lists" ]; then
        config_list_foreach "$section" "community_lists" collect_community_list_matchers
    fi

    collect_user_domain_list "$section"
    collect_user_subnet_list "$section"

    local local_domain_lists local_subnet_lists
    config_get local_domain_lists "$section" "local_domain_lists"
    config_get local_subnet_lists "$section" "local_subnet_lists"
    if [ -n "$local_domain_lists" ]; then
        config_list_foreach "$section" "local_domain_lists" collect_file_domain_matchers "local-$section-"
    fi
    if [ -n "$local_subnet_lists" ]; then
        config_list_foreach "$section" "local_subnet_lists" collect_file_subnet_matchers "local-$section-"
    fi

    local remote_domain_lists remote_subnet_lists
    config_get remote_domain_lists "$section" "remote_domain_lists"
    config_get remote_subnet_lists "$section" "remote_subnet_lists"
    if [ -n "$remote_domain_lists" ]; then
        config_list_foreach "$section" "remote_domain_lists" collect_file_domain_matchers "remote-$section-"
    fi
    if [ -n "$remote_subnet_lists" ]; then
        config_list_foreach "$section" "remote_subnet_lists" collect_file_subnet_matchers "remote-$section-"
    fi

    write_matchers_file "$section" "domains" "$domain_items"
    write_matchers_file "$section" "ips" "$ip_items"
}

collect_community_list_matchers() {
    local service="$1"

    if ! file_exists "$TMP_XRAY_FOLDER/geosite.dat"; then
        log "geosite.dat is missing, the '$service' community list is skipped" "warn"
        return 0
    fi

    if [ -z "$domain_items" ]; then
        domain_items="ext:geosite.dat:$(community_geosite_tag "$service")"
    else
        domain_items="$domain_items,ext:geosite.dat:$(community_geosite_tag "$service")"
    fi

    # Community subnet lists were imported into nft by list_update; the same
    # files feed the ip matchers of the section
    local subnet_lst="$TMP_LISTS_FOLDER/community-$service.lst"
    if file_exists "$subnet_lst"; then
        local subnets
        subnets=$(parse_domain_or_subnet_file_to_comma_string "$subnet_lst" "subnets")
        if [ -n "$subnets" ]; then
            if [ -z "$ip_items" ]; then
                ip_items="$subnets"
            else
                ip_items="$ip_items,$subnets"
            fi
        fi
    fi
}

collect_user_domain_list() {
    local section="$1"

    local user_domain_list_type items
    config_get user_domain_list_type "$section" "user_domain_list_type" "disabled"
    [ "$user_domain_list_type" = "disabled" ] && return 0

    case "$user_domain_list_type" in
    dynamic) config_get items "$section" "user_domains" ;;
    text) config_get items "$section" "user_domains_text" ;;
    *) return 0 ;;
    esac

    items="$(parse_domain_or_subnet_string_to_commas_string "$items" "domains")"
    [ -z "$items" ] && return 0

    local item
    for item in ${items//,/ }; do
        if [ -z "$domain_items" ]; then
            domain_items="domain:$item"
        else
            domain_items="$domain_items,domain:$item"
        fi
    done
}

collect_user_subnet_list() {
    local section="$1"

    local user_subnet_list_type items
    config_get user_subnet_list_type "$section" "user_subnet_list_type" "disabled"
    [ "$user_subnet_list_type" = "disabled" ] && return 0

    case "$user_subnet_list_type" in
    dynamic) config_get items "$section" "user_subnets" ;;
    text) config_get items "$section" "user_subnets_text" ;;
    *) return 0 ;;
    esac

    items="$(parse_domain_or_subnet_string_to_commas_string "$items" "subnets")"
    [ -z "$items" ] && return 0

    if [ -z "$ip_items" ]; then
        ip_items="$items"
    else
        ip_items="$ip_items,$items"
    fi

    nft_add_set_elements "$NFT_TABLE_NAME" "$NFT_COMMON_SET_NAME" "$items"
}

# Collects matchers from a list file downloaded by list_update
# (remote-<section>-<name>.lst) or copied by import_local_lists
# (local-<section>-<name>).
collect_file_domain_matchers() {
    local list_file="$1"
    local prefix="$2"

    collect_file_matchers "$list_file" "domains" "$prefix"
}

collect_file_subnet_matchers() {
    local list_file="$1"
    local prefix="$2"

    collect_file_matchers "$list_file" "subnets" "$prefix"
}

collect_file_matchers() {
    local list_file="$1"
    local type="$2"
    local prefix="$3"

    local normalized="${list_file#"$prefix"}"
    local stored_file="$TMP_LISTS_FOLDER/$prefix$normalized"

    if ! file_exists "$stored_file" ]; then
        log "List file $stored_file not found, skipping" "warn"
        return 1
    fi

    while IFS= read -r line; do
        line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        [ -z "$line" ] && continue

        case "$type" in
        domains)
            case "$line" in
            domain:* | full:* | keyword:* | regexp:* | dotless:*)
                item="$line"
                ;;
            *)
                if is_domain_suffix "$line"; then
                    item="domain:$line"
                else
                    log "'$line' is not a valid domain" "debug"
                    continue
                fi
                ;;
            esac
            if [ -z "$domain_items" ]; then
                domain_items="$item"
            else
                domain_items="$domain_items,$item"
            fi
            ;;
        subnets)
            if ! is_ipv4_ip_or_ipv4_cidr "$line"; then
                log "'$line' is not IPv4 or IPv4 CIDR" "debug"
                continue
            fi
            if [ -z "$ip_items" ]; then
                ip_items="$line"
            else
                ip_items="$ip_items,$line"
            fi
            ;;
        esac
    done < "$stored_file"
}

write_matchers_file() {
    local section="$1"
    local type="$2"
    local items="$3"

    if [ -z "$items" ]; then
        echo "[]" > "$TMP_LISTS_FOLDER/matchers/$section.$type.json"
        return 0
    fi

    comma_string_to_json_array "$items" > "$TMP_LISTS_FOLDER/matchers/$section.$type.json"
}

read_section_domains() {
    local section="$1"
    cat "$TMP_LISTS_FOLDER/matchers/$section.domains.json" 2> /dev/null || echo "[]"
}

read_section_ips() {
    local section="$1"
    cat "$TMP_LISTS_FOLDER/matchers/$section.ips.json" 2> /dev/null || echo "[]"
}

configure_outbound_handler() {
    local section="$1"

    local connection_type
    config_get connection_type "$section" "connection_type"
    case "$connection_type" in
    proxy)
        log "Configuring outbound in proxy connection type for the $section section"
        local proxy_config_type
        config_get proxy_config_type "$section" "proxy_config_type"

        case "$proxy_config_type" in
        url)
            local proxy_string
            config_get proxy_string "$section" "proxy_string"

            if [ -z "$proxy_string" ]; then
                log "Proxy string is not set. Aborted." "fatal"
                exit 1
            fi
            config=$(xray_cf_add_proxy_outbound "$config" "$section" "$proxy_string")
            ;;
        outbound)
            local json_outbound
            config_get json_outbound "$section" "outbound_json"
            config=$(xray_cf_add_json_outbound "$config" "$section" "$json_outbound")
            ;;
        selector | urltest)
            local links links_var strategy interval testing_url fallback_links fallback_tag outbound_tag selector_tag
            if [ "$proxy_config_type" = "selector" ]; then
                links_var="selector_proxy_links"
                strategy="random"
            else
                links_var="urltest_proxy_links"
                strategy="leastPing"
            fi

            config_get links "$section" "$links_var"
            config_get fallback_links "$section" "urltest_fallback_links"
            config_get interval "$section" "urltest_check_interval" "3m"
            config_get testing_url "$section" "urltest_testing_url" "https://www.gstatic.com/generate_204"

            if [ -z "$links" ]; then
                log "Proxy links of the $section section are not set. Aborted." "fatal"
                exit 1
            fi

            if [ -n "$fallback_links" ]; then
                log "Fallback links of the $section section: only the first one is used (Xray supports a single fallbackTag)" "warn"
                config=$(xray_cf_add_proxy_outbound "$config" "$section-fallback-1" "$(echo "$fallback_links" | awk '{print $1}')")
                fallback_tag="$(get_outbound_tag_by_section "$section-fallback-1")"
            fi

            local i=1
            for link in $links; do
                config="$(xray_cf_add_proxy_outbound "$config" "$section-$i" "$link")"
                i=$((i + 1))
            done

            selector_tag="$(get_outbound_tag_by_section "$section")"
            config="$(xray_cm_add_balancer "$config" "$selector_tag" "$section-" "$strategy" "$fallback_tag")"

            if [ "$strategy" = "leastPing" ]; then
                config="$(xray_cm_configure_burst_observatory "$config" "$section-" "$testing_url" "$interval")"
            fi
            ;;
        *)
            log "Unknown proxy configuration type: '$proxy_config_type'. Aborted." "fatal"
            exit 1
            ;;
        esac
        ;;
    vpn)
        log "Configuring outbound in VPN connection type for the $section section"
        local interface_name domain_lists_present

        config_get interface_name "$section" "interface"
        if [ -z "$interface_name" ]; then
            log "VPN interface is not set. Aborted." "fatal"
            exit 1
        fi

        # A Freedom outbound dials domains via the built-in DNS, which returns
        # fake IPs for FakeDNS whitelist domains: an infinite dial loop. VPN
        # sections support subnet routing only in this version
        domain_lists_present=$(jq -r 'length' "$TMP_LISTS_FOLDER/matchers/$section.domains.json" 2>/dev/null || echo 0)
        if [ "$domain_lists_present" != "0" ]; then
            log "Domain lists of the '$section' VPN section are not supported: move them to a proxy section. Aborted." "fatal"
            exit 1
        fi

        config=$(xray_cf_add_interface_outbound "$config" "$section" "$interface_name")
        ;;
    block)
        log "Connection type 'block' detected for the $section section – no outbound will be created (handled via blackhole route rules)"
        ;;
    exclusion)
        log "Connection type 'exclusion' detected for the $section section – no outbound will be created (handled via direct route rules)"
        ;;
    *)
        log "Unknown connection type '$connection_type' for the $section section. Aborted." "fatal"
        exit 1
        ;;
    esac
}


xray_configure_dns() {
    log "Configure the DNS section of an Xray JSON configuration" "debug"

    local dns_type dns_server bootstrap_dns_server
    config_get dns_type "settings" "dns_type" "udp"
    config_get dns_server "settings" "dns_server" "1.1.1.1"
    config_get bootstrap_dns_server "settings" "bootstrap_dns_server" "77.88.8.8"

    # Only proxied and blocked sections resolve to fake IPs: freedom
    # outbounds must never dial a fake IP
    local fake_domains="[]"
    local section connection_type domains
    for section in $(get_all_sections_with_domain_lists); do
        config_get connection_type "$section" "connection_type"
        case "$connection_type" in
        proxy | block)
            domains=$(read_section_domains "$section")
            if [ "$domains" != "[]" ]; then
                fake_domains=$(jq -n --argjson cur "$fake_domains" --argjson add "$domains" '$cur + $add')
            fi
            ;;
        esac
    done

    # The service check domains are routed through the core as well
    if [ -n "$(get_first_outbound_section)" ]; then
        fake_domains=$(jq -n --argjson cur "$fake_domains" --arg domain "full:$CHECK_PROXY_IP_DOMAIN" '$cur + [$domain]')
    fi

    config=$(xray_cm_configure_dns "$config" "$XRAY_DNS_TAG" "UseIPv4" "{}")
    config=$(xray_cf_add_fakedns_server "$config" "$fake_domains")
    config=$(xray_cf_add_dns_servers "$config" "$dns_type" "$dns_server" "$bootstrap_dns_server")
    config=$(xray_cm_configure_fakedns "$config" "$XRAY_FAKEIP_INET4_RANGE" "$XRAY_FAKEIP_POOL_SIZE")
}

_all_sections_with_lists_cb() {
    local section="$1"

    section_has_enabled_lists "$section" && echo "$section"
}

get_all_sections_with_domain_lists() {
    config_foreach _all_sections_with_lists_cb "section"
}

xray_configure_route() {
    log "Configure the routing section of an Xray JSON configuration" "debug"

    # DNS queries received by the dns inbound are answered by the DNS outbound
    config=$(xray_cm_add_route_rule "$config" "$(jq -n \
        --arg tag "$XRAY_DNS_INBOUND_TAG" --arg outbound "$XRAY_DNS_OUTBOUND_TAG" \
        '{"inboundTag": [$tag], "outboundTag": $outbound}')")

    # DNS queries of the DNS module itself go directly
    config=$(xray_cm_add_route_rule "$config" "$(jq -n \
        --arg tag "$XRAY_DNS_TAG" --arg outbound "$XRAY_DIRECT_OUTBOUND_TAG" \
        '{"inboundTag": [$tag], "outboundTag": $outbound}')")

    local disable_quic
    config_get_bool disable_quic "settings" "disable_quic" 0
    if [ "$disable_quic" -eq 1 ]; then
        config=$(xray_cm_add_route_rule "$config" "$(jq -n \
            --arg tag "$XRAY_TPROXY_INBOUND_TAG" --arg outbound "$XRAY_BLACKHOLE_OUTBOUND_TAG" \
            '{"inboundTag": [$tag], "network": "udp", "port": 443, "outboundTag": $outbound}')")
    fi

    # FakeIP check service: dnsmasq pins the domain to a fixed fake IP, the
    # redirect outbound dials the real service on port 8443
    if printf '%s\n' "$config" | jq -e --arg tag "$XRAY_FAKEIP_TEST_OUTBOUND_TAG" \
        '.outbounds[] | select(.tag == $tag)' > /dev/null 2>&1; then
        config=$(xray_cm_add_route_rule "$config" "$(jq -n \
            --arg tag "$XRAY_TPROXY_INBOUND_TAG" --arg outbound "$XRAY_FAKEIP_TEST_OUTBOUND_TAG" \
            --arg domain "full:$FAKEIP_TEST_DOMAIN" \
            '{"inboundTag": [$tag], "domain": [$domain], "outboundTag": $outbound}')")
    fi

    # The check domain reports the exit IP of the first proxy section
    local first_outbound_section first_outbound_tag
    first_outbound_section="$(get_first_outbound_section)"
    if [ -n "$first_outbound_section" ]; then
        first_outbound_tag="$(get_outbound_tag_by_section "$first_outbound_section")"
        config=$(xray_cm_add_route_rule "$config" "$(xray_cf_build_section_rule \
            "$XRAY_TPROXY_INBOUND_TAG" "$first_outbound_tag" "domain" "[\"full:$CHECK_PROXY_IP_DOMAIN\"]" 0)")
    fi

    local routing_excluded_ips
    config_get routing_excluded_ips "settings" "routing_excluded_ips"
    if [ -n "$routing_excluded_ips" ]; then
        local ips_json
        ips_json=$(uci -q get perekop.settings.routing_excluded_ips | jq -R -s 'split("\n")[:-1] | map(select(length > 0))')
        config=$(xray_cm_add_route_rule "$config" "$(jq -n \
            --arg tag "$XRAY_TPROXY_INBOUND_TAG" --arg outbound "$XRAY_DIRECT_OUTBOUND_TAG" \
            --argjson ips "$ips_json" \
            '{"inboundTag": [$tag], "source": $ips, "outboundTag": $outbound}')")
    fi

    configure_common_block_rules
    configure_common_exclusion_rules

    config_foreach include_fully_routed_ips "section"
    config_foreach configure_routing_for_section_lists "section"
}

include_fully_routed_ips() {
    local section="$1"

    local fully_routed_ips
    config_get fully_routed_ips "$section" "fully_routed_ips"
    if [ -z "$fully_routed_ips" ]; then
        return 0
    fi

    local ips_json
    ips_json=$(uci -q get "perekop.$section.fully_routed_ips" | jq -R -s 'split("\n")[:-1] | map(select(length > 0))')
    if [ "$ips_json" = "[]" ]; then
        return 0
    fi

    nft_list_all_traffic_from_ip_items "$section"

    config=$(xray_cm_add_route_rule "$config" "$(jq -n \
        --arg tag "$XRAY_TPROXY_INBOUND_TAG" \
        --arg outbound "$(get_outbound_tag_by_section "$section")" \
        --argjson ips "$ips_json" \
        '{"inboundTag": [$tag], "source": $ips, "outboundTag": $outbound}')")
}

nft_list_all_traffic_from_ip_items() {
    local section="$1"
    local ip

    for ip in $(uci -q get "perekop.$section.fully_routed_ips" 2>/dev/null); do
        if ! nft list chain inet "$NFT_TABLE_NAME" mangle | grep -q "ip saddr $ip"; then
            nft insert rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" ip saddr "$ip" \
                meta l4proto tcp meta mark set "$NFT_FAKEIP_MARK" counter
            nft insert rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" ip saddr "$ip" \
                meta l4proto udp meta mark set "$NFT_FAKEIP_MARK" counter
            nft insert rule inet "$NFT_TABLE_NAME" mangle ip saddr "$ip" ip daddr @localv4 return
        fi
    done
}

configure_common_block_rules() {
    local block_section domains ips domains_json ips_json

    for block_section in $(get_sections_by_connection_type "block"); do
        if ! section_has_enabled_lists "$block_section"; then
            continue
        fi

        domains=$(read_section_domains "$block_section")
        ips=$(read_section_ips "$block_section")

        [ "$domains" != "[]" ] && config=$(xray_cm_add_route_rule "$config" \
            "$(xray_cf_build_section_rule "$XRAY_TPROXY_INBOUND_TAG" "$XRAY_BLACKHOLE_OUTBOUND_TAG" "domain" "$domains" 0)")
        [ "$ips" != "[]" ] && config=$(xray_cm_add_route_rule "$config" \
            "$(xray_cf_build_section_rule "$XRAY_TPROXY_INBOUND_TAG" "$XRAY_BLACKHOLE_OUTBOUND_TAG" "ip" "$ips" 0)")
    done
}

configure_common_exclusion_rules() {
    local exclusion_section domains ips

    for exclusion_section in $(get_sections_by_connection_type "exclusion"); do
        if ! section_has_enabled_lists "$exclusion_section"; then
            continue
        fi

        # Exclusion domains are not in the FakeDNS whitelist: they resolve to
        # real IPs and bypass the core entirely, the desired behavior
        domains=$(read_section_domains "$exclusion_section")
        ips=$(read_section_ips "$exclusion_section")

        [ "$ips" != "[]" ] && config=$(xray_cm_add_route_rule "$config" \
            "$(xray_cf_build_section_rule "$XRAY_TPROXY_INBOUND_TAG" "$XRAY_DIRECT_OUTBOUND_TAG" "ip" "$ips" 0)")
    done
}

configure_routing_for_section_lists() {
    local section="$1"

    if ! section_has_enabled_lists "$section"; then
        log "Section '$section' does not have any enabled list, skipping..." "warn"
        return 0
    fi

    local section_connection_type domains ips
    config_get section_connection_type "$section" "connection_type"

    case "$section_connection_type" in
    proxy | vpn)
        local use_balancer=0
        local proxy_config_type
        config_get proxy_config_type "$section" "proxy_config_type"
        if [ "$section_connection_type" = "proxy" ] &&
            { [ "$proxy_config_type" = "selector" ] || [ "$proxy_config_type" = "urltest" ]; }; then
            use_balancer=1
        fi

        local outbound_tag
        outbound_tag=$(get_outbound_tag_by_section "$section")

        domains=$(read_section_domains "$section")
        ips=$(read_section_ips "$section")

        [ "$domains" != "[]" ] && config=$(xray_cm_add_route_rule "$config" \
            "$(xray_cf_build_section_rule "$XRAY_TPROXY_INBOUND_TAG" "$outbound_tag" "domain" "$domains" "$use_balancer")")
        [ "$ips" != "[]" ] && config=$(xray_cm_add_route_rule "$config" \
            "$(xray_cf_build_section_rule "$XRAY_TPROXY_INBOUND_TAG" "$outbound_tag" "ip" "$ips" "$use_balancer")")
        ;;
    block | exclusion)
        # Handled by the common rules
        ;;
    *)
        log "Unsupported '$section_connection_type' connection type. Skipping routing for '$section' section" "fatal"
        exit 1
        ;;
    esac
}

xray_configure_experimental() {
    log "Configure the experimental sections of an Xray JSON configuration" "debug"

    config=$(xray_cm_configure_api "$config" "api" "$XRAY_API_LISTEN_ADDRESS:$XRAY_API_LISTEN_PORT")
}

xray_save_config() {
    local xray_config_path temp_file_path current_config_hash temp_config_hash
    config_get xray_config_path "settings" "config_path" "/etc/xray/config.json"
    temp_file_path="$(mktemp)"
    # Xray sniffs the config format by file extension, keep the .json suffix
    rm -f "$temp_file_path"
    temp_file_path="$temp_file_path.json"

    log "Save Xray temporary config to $temp_file_path" "debug"
    xray_cm_save_config_to_file "$config" "$temp_file_path"

    xray_cm_check_config "$temp_file_path"

    current_config_hash=$(md5sum "$xray_config_path" 2> /dev/null | awk '{print $1}')
    temp_config_hash=$(md5sum "$temp_file_path" | awk '{print $1}')
    if [ "$current_config_hash" != "$temp_config_hash" ]; then
        log "Xray configuration has changed and will be updated"
        mv "$temp_file_path" "$xray_config_path"
    else
        log "Xray configuration is unchanged"
        rm -f "$temp_file_path"
    fi
}

xray_apply_balancer_overrides() {
    # Re-apply the manually selected outbounds after a core restart:
    # "xray api bo" overrides live in the core memory only
    local section selector_selected balancer_tag

    for section in $(uci show perekop 2>/dev/null | grep "^perekop\..*\.type='section'" | cut -d. -f2 | cut -d= -f1 | cut -d"'" -f1); do
        selector_selected="$(uci -q get "perekop.$section.selector_selected")"
        [ -z "$selector_selected" ] && continue

        balancer_tag="$(get_outbound_tag_by_section "$section")"
        xray api bo -s "$XRAY_API_LISTEN_ADDRESS:$XRAY_API_LISTEN_PORT" -b "$balancer_tag" "$selector_selected" > /dev/null 2>&1 \
            && log "The $balancer_tag balancer is pinned to $selector_selected" "debug"
    done
}


# Diagnostics
check_proxy() {
    local xray_config_path
    config_get xray_config_path "settings" "config_path" "/etc/xray/config.json"

    if ! command -v xray > /dev/null 2>&1; then
        nolog "xray is not installed"
        return 1
    fi

    if [ ! -f "$xray_config_path" ]; then
        nolog "Configuration file not found"
        return 1
    fi

    nolog "Checking xray configuration..."

    if ! XRAY_LOCATION_ASSET="$TMP_XRAY_FOLDER" xray run -test -c "$xray_config_path" 2>&1 | grep -q "Configuration OK."; then
        nolog "Invalid configuration"
        return 1
    fi

    jq '
    walk(
        if type == "object" then
            with_entries(
                if .key == "id" then
                    .value = "MASKED"
                elif .key == "address" then
                    .value = "MASKED"
                elif .key == "serverName" then
                    .value = "MASKED"
                elif .key == "password" then
                    .value = "MASKED"
                elif .key == "publicKey" then
                    .value = "MASKED"
                elif .key == "shortId" then
                    .value = "MASKED"
                elif .key == "fingerprint" then
                    .value = "MASKED"
                elif .key == "port" then
                    .value = "MASKED"
                elif .key == "auth" then
                    .value = "MASKED"
                elif .key == "pass" then
                    .value = "MASKED"
                else . end
            )
        else . end
    )' "$xray_config_path"

    nolog "Checking proxy connection..."

    local first_outbound_section first_outbound_tag
    first_outbound_section="$(get_first_outbound_section)"
    if [ -z "$first_outbound_section" ]; then
        nolog "No proxy section found, nothing to check"
        return 1
    fi
    first_outbound_tag="$(get_outbound_tag_by_section "$first_outbound_section")"

    # Xray has no "tools fetch": a temporary core instance with a SOCKS
    # inbound routed to the first proxy outbound is started instead
    local temp_config temp_port temp_pid response
    temp_config=$(mktemp)
    temp_port=$((20000 + RANDOM % 20000))

    jq -n \
        --argjson outbound "$(jq -c --arg tag "$first_outbound_tag" '.outbounds[] | select(.tag == $tag)' "$xray_config_path")" \
        --argjson port "$temp_port" \
        '{
            "log": {"loglevel": "error"},
            "inbounds": [{"listen": "127.0.0.1", "port": $port, "protocol": "socks", "settings": {"auth": "noauth", "udp": false}, "tag": "chk"}],
            "outbounds": [$outbound, {"protocol": "freedom", "tag": "direct"}],
            "routing": {"rules": [{"inboundTag": ["chk"], "outboundTag": ($outbound.tag // "direct")}]}
        }' > "$temp_config"

    xray run -c "$temp_config" > /dev/null 2>&1 &
    temp_pid=$!

    local attempt
    for attempt in 1 2 3 4 5; do
        sleep 1
        response=$(curl -m 8 -s --socks5-hostname "127.0.0.1:$temp_port" ifconfig.me 2> /dev/null)
        if [ -n "$response" ]; then
            break
        fi
    done

    kill "$temp_pid" 2> /dev/null
    rm -f "$temp_config"

    if echo "$response" | grep -q "^[0-9]\+\.[0-9]\+\.[0-9]\+\.[0-9]\+$"; then
        nolog "$response - should match proxy IP"
        return 0
    fi

    if echo "$response" | grep -q "^[0-9a-fA-F:]*:[0-9a-fA-F:]*$"; then
        nolog "$response - should match proxy IP"
        return 0
    fi

    nolog "Failed to get a valid response through the proxy"
    [ -z "$response" ] || nolog "Error response: $response"
    return 1
}

check_nft() {
    if ! command -v nft > /dev/null 2>&1; then
        nolog "nft is not installed"
        return 1
    fi

    nolog "Checking $NFT_TABLE_NAME rules..."

    # Check if table exists
    if ! nft list table inet "$NFT_TABLE_NAME" > /dev/null 2>&1; then
        nolog "❌ $NFT_TABLE_NAME not found"
        return 1
    fi

    local found_hetzner=0
    local found_ovh=0

    check_domain_list_contains() {
        local section="$1"

        config_get_bool domain_list_enabled "$section" "domain_list_enabled" "0"
        if [ "$domain_list_enabled" -eq 1 ]; then
            config_list_foreach "$section" "domain_list" check_domain_value
        fi
    }

    check_domain_value() {
        local domain_value="$1"

        if [ "$domain_value" = "hetzner" ]; then
            found_hetzner=1
        elif [ "$domain_value" = "ovh" ]; then
            found_ovh=1
        fi
    }

    config_foreach check_domain_list_contains

    if [ "$found_hetzner" -eq 1 ] || [ "$found_ovh" -eq 1 ]; then

        local sets="perekop_subnets perekop_domains interfaces perekop_discord_subnets localv4"

        nolog "Sets statistics:"
        for set_name in $sets; do
            if nft list set inet "$NFT_TABLE_NAME" $set_name > /dev/null 2>&1; then
                # Count elements using grep to count commas and add 1 (last element has no comma)
                local count=$(nft list set inet "$NFT_TABLE_NAME" $set_name 2> /dev/null | grep -o ',\|{' | wc -l)
                echo "- $set_name: $count elements"
            fi
        done

        nolog "Chain configurations:"

        # Create a temporary file for processing
        local tmp_file=$(mktemp)
        nft list table inet "$NFT_TABLE_NAME" > "$tmp_file"

        # Extract chain configurations without element listings
        sed -n '/chain mangle {/,/}/p' "$tmp_file" | grep -v "elements" | grep -v "^[[:space:]]*[0-9]"
        sed -n '/chain proxy {/,/}/p' "$tmp_file" | grep -v "elements" | grep -v "^[[:space:]]*[0-9]"

        # Clean up
        rm -f "$tmp_file"
    else
        # Simple view as originally implemented
        nolog "Sets configuration:"
        nft list table inet "$NFT_TABLE_NAME"
    fi

    nolog "NFT check completed"
}

check_logs() {
    if ! command -v logread > /dev/null 2>&1; then
        nolog "Error: logread command not found"
        return 1
    fi

    local logs
    logs=$(logread | grep -E "perekop|xray")

    if [ -z "$logs" ]; then
        nolog "Logs not found"
        return 1
    fi

    # Find the last occurrence of "Starting perekop"
    local start_line
    start_line=$(echo "$logs" | grep -n "perekop.*Starting perekop" | tail -n 1 | cut -d: -f1)

    if [ -n "$start_line" ]; then
        echo "$logs" | tail -n +"$start_line"
    else
        nolog "No 'Starting perekop' message found, showing last 100 lines"
        echo "$logs" | tail -n 100
    fi
}


show_xray_config() {
    local xray_config_path
    config_get xray_config_path "settings" "config_path" "/etc/xray/config.json"
    nolog "Current xray configuration:"

    if [ ! -f "$xray_config_path" ]; then
        nolog "Configuration file not found"
        return 1
    fi

    jq '
    walk(
        if type == "object" then
            with_entries(
                if .key == "id" then
                    .value = "MASKED"
                elif .key == "address" then
                    .value = "MASKED"
                elif .key == "serverName" then
                    .value = "MASKED"
                elif .key == "password" then
                    .value = "MASKED"
                elif .key == "publicKey" then
                    .value = "MASKED"
                elif .key == "shortId" then
                    .value = "MASKED"
                elif .key == "fingerprint" then
                    .value = "MASKED"
                elif .key == "auth" then
                    .value = "MASKED"
                elif .key == "pass" then
                    .value = "MASKED"
                else . end
            )
        else . end
    )' "$xray_config_path"
}

show_xray_version() {
    xray_get_version
}

get_xray_features() {
    local features="["
    local first=1

    if xray_has_feature "proxy.hysteria2"; then
        features="$features\"proxy.hysteria2\""
        first=0
    fi

    if xray_has_feature "tls.ech"; then
        [ "$first" -eq 0 ] && features="$features,"
        features="$features\"tls.ech\""
        first=0
    fi

    echo "$features]"
}

get_system_info() {
    local perekop_version perekop_latest_version luci_app_version xray_version openwrt_version device_model

    perekop_version="$PEREKOP_VERSION"

    perekop_latest_version=$(curl -m 3 -s https://api.github.com/repos/tangenx/perekop/releases/latest | grep '"tag_name":' | cut -d'"' -f4)
    [ -z "$perekop_latest_version" ] && perekop_latest_version="unknown"

    if [ -f /www/luci-static/resources/view/perekop/main.js ]; then
        luci_app_version=$(grep 'var PEREKOP_LUCI_APP_VERSION' /www/luci-static/resources/view/perekop/main.js | cut -d'"' -f2)
    else
        luci_app_version="not installed"
    fi

    xray_version=$(xray_get_version)
    [ -z "$xray_version" ] && xray_version="not installed"

    if [ -f /etc/os-release ]; then
        openwrt_version=$(grep OPENWRT_RELEASE /etc/os-release | cut -d'"' -f2)
        [ -z "$openwrt_version" ] && openwrt_version="unknown"
    else
        openwrt_version="unknown"
    fi

    if [ -f /tmp/sysinfo/model ]; then
        device_model=$(cat /tmp/sysinfo/model)
        [ -z "$device_model" ] && device_model="unknown"
    else
        device_model="unknown"
    fi

    echo "{\"perekop_version\": \"$perekop_version\", \"perekop_latest_version\": \"$perekop_latest_version\", \"luci_app_version\": \"$luci_app_version\", \"xray_version\": \"$xray_version\", \"openwrt_version\": \"$openwrt_version\", \"device_model\": \"$device_model\"}" | jq .
}

get_xray_status() {
    local running=0
    local enabled=0
    local status=""

    if [ -x /etc/rc.d/S99xray ]; then
        enabled=1
    fi

    if pgrep -f "xray run" > /dev/null 2>&1; then
        running=1
    fi

    if [ $running -eq 1 ]; then
        if [ $enabled -eq 1 ]; then
            status="running & enabled"
        else
            status="running but disabled"
        fi
    else
        if [ $enabled -eq 1 ]; then
            status="stopped but enabled"
        else
            status="stopped & disabled"
        fi
    fi

    echo "{\"running\":$running,\"enabled\":$enabled,\"status\":\"$status\"}"
}


show_config() {
    if [ ! -f "$PEREKOP_CONFIG" ]; then
        nolog "Configuration file not found"
        return 1
    fi

    tmp_config=$(mktemp)

    sed -e 's/\(option proxy_string\).*/\1 '\''MASKED'\''/g' \
        -e '/option outbound_json/,/^}/c\	option outbound_json '\''MASKED'\''' \
        -e 's/\(list urltest_proxy_links\).*/\1 '\''MASKED'\''/g' \
        -e 's/\(list urltest_fallback_links\).*/\1 '\''MASKED'\''/g' \
        -e 's/\(list selector_proxy_links\).*/\1 '\''MASKED'\''/g' \
        -e "s@\\(option dns_server '[^/]*\\)/[^']*'@\\1/MASKED'@g" \
        -e "s@\\(option domain_resolver_dns_server '[^/]*\\)/[^']*'@\\1/MASKED'@g" \
            "$PEREKOP_CONFIG" > "$tmp_config"

    cat "$tmp_config"
    rm -f "$tmp_config"
}

show_version() {
    echo "$PEREKOP_VERSION"
}

