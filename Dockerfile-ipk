FROM itdoginfo/openwrt-sdk-ipk:24.10.6

ARG PEREKOP_VERSION

COPY ./perekop /builder/package/feeds/utilities/perekop
COPY ./luci-app-perekop /builder/package/feeds/luci/luci-app-perekop

RUN export PEREKOP_VERSION="v${PEREKOP_VERSION}" && \
    make defconfig && \
    make package/perekop/compile V=s -j4 && \
    make package/luci-app-perekop/compile V=s -j4